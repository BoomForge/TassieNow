---
interface Props { placement: 'homepage-top' | 'homepage-inline' | 'site-footer'; className?: string; }
const { placement, className = '' } = Astro.props;
---
<div class={`ad-slot ${className}`} data-ad-placement={placement} hidden>
  <div class="ad-label">Advertisement</div>
  <a class="ad-link" rel="sponsored noopener" target="_blank">
    <img class="ad-image" loading="lazy" decoding="async" alt="" />
    <span class="ad-sponsor"></span>
  </a>
</div>
<script>
  async function loadAds() {
    const slots = [...document.querySelectorAll('[data-ad-placement]')];
    await Promise.all(slots.map(async (slot) => {
      if (slot.dataset.loaded) return;
      slot.dataset.loaded = '1';
      try {
        const response = await fetch(`/api/ads?placement=${encodeURIComponent(slot.dataset.adPlacement)}`, { headers: { accept: 'application/json' }, cache: 'no-store' });
        if (!response.ok) return;
        const { ad } = await response.json();
        if (!ad) return;
        const link = slot.querySelector('.ad-link'), image = slot.querySelector('.ad-image'), sponsor = slot.querySelector('.ad-sponsor');
        link.href = ad.click_url; image.src = ad.image_url; image.alt = ad.alt_text; sponsor.textContent = `Sponsored by ${ad.sponsor_name}`;
        image.addEventListener('load', () => { slot.hidden = false; }, { once: true });
        image.addEventListener('error', () => { slot.hidden = true; }, { once: true });
      } catch { /* ad slots fail closed */ }
    }));
  }
  loadAds();
</script>
<style>
  .ad-slot{max-width:1120px;margin:1.25rem auto;padding:.7rem;border:1px solid #dce5e7;border-radius:18px;background:#fff;box-shadow:0 10px 30px rgba(6,45,50,.06)}
  .ad-label{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#65777a;margin:0 0 .45rem .2rem}
  .ad-link{display:block;color:inherit;text-decoration:none}
  .ad-image{display:block;width:100%;max-height:180px;object-fit:cover;border-radius:12px;background:#eef5f5}
  .ad-sponsor{display:block;padding:.45rem .2rem 0;font-size:.78rem;color:#526467}
  .site-footer-ad{margin-top:2rem;margin-bottom:1rem}
</style>
