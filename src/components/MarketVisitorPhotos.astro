---
import {googleMarketSearchUrl} from '../lib/google-market-photos.mjs';
const {name,town,reviewUrl} = Astro.props;
const search=googleMarketSearchUrl(name,town);
const link=(typeof reviewUrl==='string' && /^https:\/\/(?:www\.)?(?:google\.[^/]+|maps\.app\.goo\.gl)\//i.test(reviewUrl))
  ? reviewUrl : search;
---
<section class="market-visitor-photos section-card" aria-labelledby="market-visitor-photos-heading">
  <div class="market-photo-heading">
    <div>
      <p class="section-kicker">Photographed by visitors</p>
      <h2 id="market-visitor-photos-heading">Visitor photos & Google reviews</h2>
    </div>
  </div>
  <p>Browse photographs and experiences shared by visitors directly on Google Maps. No paid API, account or billing setup is needed on TassieNow.</p>
  <a class="market-photo-link" href={link} target="_blank" rel="noopener noreferrer" data-track-outbound="market-google-photos">
    View visitor photos on Google Maps ↗
  </a>
  <p class="market-photo-note">Visitor photos belong to their photographers and remain on Google Maps. TassieNow displays independently licensed images in the gallery below.</p>
</section>
<style>
  .market-visitor-photos{display:grid;gap:.8rem}
  .market-photo-heading h2{font-size:clamp(1.4rem,3vw,2rem);line-height:1.15;margin:.25rem 0}
  .market-visitor-photos>p{margin:0;color:var(--muted);font-size:.92rem;line-height:1.5}
  .market-photo-link{display:inline-flex;align-items:center;justify-content:center;min-height:44px;width:fit-content;
    background:var(--brand);border-radius:.85rem;color:#fff;font-weight:800;padding:.8rem 1.1rem;text-decoration:none}
  .market-photo-link:hover{text-decoration:underline}
  .market-photo-link:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
  .market-photo-note{font-size:.81rem!important}
</style>
