---
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; }
const { title='TassieNow — Find something to do in Tasmania', description='A Tasmanian discovery directory for locals and visitors. Find places, events and activities by location and interest.', image='/images/categories/discover.svg' }=Astro.props;
const origin=Astro.site??Astro.url.origin; const canonical=new URL(Astro.url.pathname,origin); const socialImage=image.startsWith('http')?image:new URL(image,origin);
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#027B87"/><meta name="robots" content="index,follow,max-image-preview:large"/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta name="twitter:card" content="summary_large_image"/><title>{title}</title></head><body><header class="site-header"><a class="brand" href="/" aria-label="TassieNow home"><img class="brand-logo" src="/brand/tassienow-logo.svg" alt="TassieNow"/></a><nav aria-label="Primary navigation"><a href="/#explore">Explore</a><a href="/discover/today/">Today</a><a href="/discover/this-weekend/">Weekend</a><a href="/about/">About</a></nav></header><main><slot/></main><footer class="site-footer"><div class="footer-brand"><img class="footer-emblem" src="/brand/tassienow-emblem.svg" alt="" aria-hidden="true"/><p><strong>TassieNow</strong> — an independent Tasmanian discovery project.</p></div><p>Listings are sourced from official/open sources and checked automatically. Always confirm time-sensitive details before travelling.</p></footer></body></html>
