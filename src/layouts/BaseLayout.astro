---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = 'TassieNow — Find something to do in Tasmania',
  description = 'A Tasmanian discovery directory for locals and visitors. Find places, events and activities by location and interest.',
  image = '/images/categories/discover.svg',
  imageAlt = 'TassieNow — discover Tasmania',
  noindex = false
} = Astro.props;

const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const socialImage = image.startsWith('http') ? image : new URL(image, origin);
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN || '';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TassieNow',
  url: new URL('/', origin).href,
  description: 'Tasmanian local and tourism discovery directory for places, walks, events and activities.'
};

const regionLinks = [
  ['Hobart & South', 'hobart-and-south'],
  ['Launceston & North', 'launceston-and-north'],
  ['East Coast', 'east-coast'],
  ['North West', 'north-west'],
  ['West Coast', 'west-coast'],
  ['Central Tasmania', 'central-tasmania'],
  ['King Island', 'king-island'],
  ['Flinders Island', 'flinders-island']
];

const discoveryLinks = [
  ['Kids', 'kids'],
  ['Free', 'free'],
  ['Rainy day', 'rainy-day'],
  ['Markets', 'markets'],
  ['Walks & nature', 'nature'],
  ['Food & produce', 'food']
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#027B87" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/atom+xml" title="TassieNow updates" href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TassieNow" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    {analyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="TassieNow home">
        <img class="brand-logo" src="/brand/tassienow-logo.svg" alt="TassieNow" />
      </a>

      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label="Open navigation"
      >
        <span></span><span></span><span></span>
      </button>

      <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
        <details class="nav-group">
          <summary>Explore Tasmania</summary>
          <div class="nav-popover nav-region-grid">
            {regionLinks.map(([label, slug]) => (
              <a href={`/region/${slug}/`}>{label}</a>
            ))}
          </div>
        </details>

        <details class="nav-group">
          <summary>Things to do</summary>
          <div class="nav-popover">
            {discoveryLinks.map(([label, slug]) => (
              <a href={`/discover/${slug}/`}>{label}</a>
            ))}
          </div>
        </details>

        <details class="nav-group">
          <summary>What’s on</summary>
          <div class="nav-popover">
            <a href="/discover/today/">Today</a>
            <a href="/discover/this-weekend/">This weekend</a>
          </div>
        </details>

        <a class="nav-direct-link" href="/#directory">Find places</a>
        <a class="nav-direct-link" href="/about/">About</a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <AdSlot placement="site-footer" className="site-footer-ad" />
      <div class="footer-brand">
        <img class="footer-emblem" src="/brand/tassienow-emblem.svg" alt="" aria-hidden="true" />
        <p><strong>TassieNow</strong> — an independent Tasmanian discovery project.</p>
      </div>
      <div class="town-links" aria-label="Explore Tasmania by region">
        {regionLinks.map(([label, slug]) => <a class="tag-link" href={`/region/${slug}/`}>{label}</a>)}
      </div>
      <div class="town-links" aria-label="Popular discovery links">
        {discoveryLinks.map(([label, slug]) => <a class="tag-link" href={`/discover/${slug}/`}>{label}</a>)}
        <a class="tag-link" href="/advertise/">Advertise</a>
      </div>
      <p>Listings are sourced from official/open sources and checked automatically. Always confirm time-sensitive details before travelling.</p>
    </footer>

    <script>
      const navToggle = document.querySelector('#nav-toggle');
      const primaryNav = document.querySelector('#primary-nav');

      navToggle?.addEventListener('click', () => {
        const open = primaryNav?.classList.toggle('open') || false;
        navToggle.setAttribute('aria-expanded', String(open));
        navToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });

      primaryNav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          primaryNav.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
          navToggle?.setAttribute('aria-label', 'Open navigation');
        });
      });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        if (event.target.closest('.site-header')) return;
        primaryNav?.querySelectorAll('details[open]').forEach((detail) => detail.removeAttribute('open'));
      });
    </script>
  </body>
</html>
