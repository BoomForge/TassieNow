---
import '../styles/global.css';
import AdSlot from '../components/AdSlot.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const { title='TassieNow — Find something to do in Tasmania', description='A Tasmanian discovery directory for locals and visitors. Find places, events and activities by location and interest.', image='/images/categories/discover.svg', noindex=false }=Astro.props;
const origin=Astro.site??Astro.url.origin; const canonical=new URL(Astro.url.pathname,origin); const socialImage=image.startsWith('http')?image:new URL(image,origin);
const websiteSchema={'@context':'https://schema.org','@type':'WebSite',name:'TassieNow',url:new URL('/',origin).href,description:'Tasmanian local and tourism discovery directory for places, walks, events and activities.'};
const regionLinks=[['Hobart & South','hobart-and-south'],['Launceston & North','launceston-and-north'],['East Coast','east-coast'],['North West','north-west'],['West Coast','west-coast'],['Central Tasmania','central-tasmania'],['King Island','king-island'],['Flinders Island','flinders-island']];
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#027B87"/><meta name="robots" content={noindex?'noindex,nofollow':'index,follow,max-image-preview:large'}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="alternate" type="application/atom+xml" title="TassieNow updates" href="/feed.xml"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script><title>{title}</title></head><body><header class="site-header"><a class="brand" href="/" aria-label="TassieNow home"><img class="brand-logo" src="/brand/tassienow-logo.svg" alt="TassieNow"/></a><nav aria-label="Primary navigation"><a href="/#explore">Explore</a><a href="/discover/today/">Today</a><a href="/discover/this-weekend/">Weekend</a><a href="/advertise/">Advertise</a><a href="/about/">About</a></nav></header><main><slot/></main><footer class="site-footer"><AdSlot placement="site-footer" className="site-footer-ad"/><div class="footer-brand"><img class="footer-emblem" src="/brand/tassienow-emblem.svg" alt="" aria-hidden="true"/><p><strong>TassieNow</strong> — an independent Tasmanian discovery project.</p></div><div class="town-links" aria-label="Explore Tasmania by region">{regionLinks.map(([label,slug])=><a class="tag-link" href={`/region/${slug}/`}>{label}</a>)}</div><div class="town-links" aria-label="Popular discovery links"><a class="tag-link" href="/discover/kids/">Kids</a><a class="tag-link" href="/discover/free/">Free</a><a class="tag-link" href="/discover/rainy-day/">Rainy day</a><a class="tag-link" href="/discover/markets/">Markets</a><a class="tag-link" href="/discover/nature/">Walks & nature</a><a class="tag-link" href="/advertise/">Advertise</a></div><p>Listings are sourced from official/open sources and checked automatically. Always confirm time-sensitive details before travelling.</p></footer></body></html>
