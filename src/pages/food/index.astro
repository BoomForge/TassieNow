---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import places from '../../data/places.json';

const types = [
  ['all','All food stops'],
  ['cafe','Cafés'], ['restaurant','Restaurants'], ['takeaway','Takeaway'],
  ['food-van','Food vans & trucks'], ['bakery','Bakeries'], ['dessert','Desserts & ice cream'],
  ['pub-food','Pub food'], ['produce','Local produce & farm gates']
];
function classify(place) {
  const text = [place.name, ...(place.categories || []), place.summary || ''].join(' ').toLowerCase();
  const matches = [];
  if (/\bcaf[eé]\b|coffee shop|coffee house/.test(text)) matches.push('cafe');
  if (/restaurant|bistro|dining|eatery/.test(text)) matches.push('restaurant');
  if (/takeaway|take-away|fish and chips|pizza shop/.test(text)) matches.push('takeaway');
  if (/food truck|food van|mobile food|mobile vendor|street food|food trailer/.test(text)) matches.push('food-van');
  if (/bakery|bakeries|patisserie|bakehouse/.test(text)) matches.push('bakery');
  if (/dessert|ice cream|ice-cream|gelato|patisserie/.test(text)) matches.push('dessert');
  if (/pub food|pub meals|gastropub|tavern|hotel restaurant/.test(text)) matches.push('pub-food');
  if (/local produce|farm.?gate|farm shop|produce|farmers.? market|food market/.test(text)) matches.push('produce');
  return matches;
}
const results = places.filter(place => place.status === 'active' && place.visibility !== 'suppressed')
  .map(place => ({...place, foodTypes: classify(place)}))
  .filter(place => (place.categories || []).some(c => ['Food & Drink','Local Produce'].includes(c)) || place.foodTypes.length)
  .sort((a,b) => (b.qualityScore || 0)-(a.qualityScore || 0) || a.name.localeCompare(b.name));
const regions = [...new Set(results.map(p => p.region).filter(Boolean))].sort();
const schema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Places to Eat in Tasmania',
  description:'Explore Tasmanian cafés, restaurants, takeaway, bakeries, food vans, pub meals and local produce.',
  url:new URL('/food/', Astro.site ?? Astro.url.origin).href,
  mainEntity:{
    '@type':'ItemList',
    itemListElement:results.slice(0,40).map((place,index)=>({
      '@type':'ListItem',position:index+1,name:place.name,
      url:new URL('/place/'+place.slug+'/', Astro.site ?? Astro.url.origin).href
    }))
  }
};
---
<BaseLayout title="Places to Eat in Tasmania | TassieNow" description="Find Tasmanian cafés, restaurants, bakeries, takeaway, food vans, pub meals and local-produce stops.">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <BreadcrumbSchema items={[{name:'TassieNow',path:'/'},{name:'Food & produce',path:'/discover/food/'},{name:'Places to Eat'}]}/>
  <div class="eat-page">
    <nav aria-label="Breadcrumb" class="crumb"><a href="/">TassieNow</a> / <a href="/discover/food/">Food & produce</a> / Places to Eat</nav>
    <p class="eyebrow">Food discovery</p>
    <h1>Places to Eat in Tasmania</h1>
    <p class="intro">From cafés and bakeries to food vans, pub meals, takeaway and farm-gate produce. Explore free, organically ranked listings across the state.</p>
    <p class="note">Food vans and market stalls can move or trade only on certain days. Check the provider’s official website or social updates before travelling; a listing is not a live location or trading-hours guarantee.</p>
    <section aria-label="Filter places to eat" class="filters">
      <label>Food type<select id="eat-type" data-track-filter="food-type">{types.map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
      <label>Region<select id="eat-region" data-track-filter="region"><option value="">All regions</option>{regions.map(region => <option value={region}>{region}</option>)}</select></label>
      <label>Search<input id="eat-search" data-track-filter="text" type="search" placeholder="Name or town…" /></label>
      <button id="eat-clear" type="button">Clear filters</button>
    </section>
    <p id="eat-count" role="status" aria-live="polite">{results.length} places</p>
    <div class="eat-grid">
      {results.map((place,index) => <article class="eat-card" hidden={index>=24} data-type={place.foodTypes.join('|')} data-region={place.region} data-search={`${place.name} ${place.town} ${(place.categories||[]).join(' ')}`.toLowerCase()}>
        <a href={`/place/${place.slug}/`}><img src={place.image?.url || '/images/categories/food.svg'} alt={place.image?.alt || place.name} loading="lazy" decoding="async" /><div class="eat-card-body"><small>{place.town} · {place.region}</small><h2>{place.name}</h2><p>{(place.categories || []).join(' · ')}</p>{place.foodTypes.includes('food-van') && <small>Mobile vendor — confirm current location</small>}</div></a>
      </article>)}
    </div>
    <p id="eat-empty" hidden>No places match these filters. Try another food type or region.</p>
    <button id="eat-more" type="button">Show more places</button>
  </div>
  <script>
    const cards = [...document.querySelectorAll('.eat-card')];
    const type = document.querySelector('#eat-type');
    const region = document.querySelector('#eat-region');
    const search = document.querySelector('#eat-search');
    const count = document.querySelector('#eat-count');
    const more = document.querySelector('#eat-more');
    const empty = document.querySelector('#eat-empty');
    let limit = 24;
    function update() {
      const q = search.value.trim().toLowerCase();
      const matches = cards.filter(c => (type.value === 'all' || c.dataset.type.split('|').includes(type.value)) && (!region.value || c.dataset.region === region.value) && (!q || c.dataset.search.includes(q)));
      cards.forEach(c => c.hidden = true);
      matches.slice(0,limit).forEach(c => c.hidden = false);
      count.textContent = `${matches.length} matching place${matches.length === 1 ? '' : 's'}`;
      empty.hidden = matches.length !== 0;
      more.hidden = limit >= matches.length;
    }
    [type,region].forEach(el => el.addEventListener('change', () => {limit=24;update();}));
    search.addEventListener('input', () => {limit=24;update();});
    document.querySelector('#eat-clear').addEventListener('click', () => {type.value='all';region.value='';search.value='';limit=24;update();});
    more.addEventListener('click', () => {limit+=24;update();});
    update();
  </script>
  <style>
    .eat-page{max-width:1160px;margin:auto;padding:2rem 1.2rem 5rem}.crumb{font-size:.85rem;margin-bottom:2rem}.eat-page h1{font-size:clamp(2.2rem,5vw,4rem);line-height:1.1;max-width:780px}.intro{max-width:760px;font-size:1.12rem;line-height:1.6}.note{max-width:820px;background:#edf3ef;padding:1rem;border-radius:.7rem;line-height:1.6}.filters{margin:2rem 0 1rem;display:grid;grid-template-columns:repeat(3,minmax(0,1fr)) auto;align-items:end;gap:.75rem}.filters label{display:grid;gap:.4rem;font-weight:700}.filters input,.filters select,.filters button,#eat-more{font:inherit;min-height:44px;border:1px solid #a7bab4;border-radius:.55rem;padding:.6rem;background:#fff;color:#19352f}.filters button,#eat-more{cursor:pointer;font-weight:750}.eat-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1rem 0 2rem}.eat-card{border:1px solid #dde5df;border-radius:1rem;overflow:hidden;background:white}.eat-card[hidden],#eat-empty[hidden],#eat-more[hidden]{display:none}.eat-card a{color:inherit;text-decoration:none}.eat-card a:hover h2{text-decoration:underline}.eat-card img{width:100%;height:190px;object-fit:cover;display:block;background:#edf3ef}.eat-card-body{padding:1rem}.eat-card h2{font-size:1.2rem;margin:.4rem 0}.eat-card p{color:#52635d;font-size:.86rem}.eat-card small{color:#52635d}.eat-page :focus-visible{outline:3px solid #026b7a;outline-offset:3px}@media(max-width:850px){.filters{grid-template-columns:1fr 1fr}.eat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.filters,.eat-grid{grid-template-columns:1fr}}
  </style>
</BaseLayout>