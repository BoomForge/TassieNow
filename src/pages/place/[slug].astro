---
import BaseLayout from '../../layouts/BaseLayout.astro';
import places from '../../data/places.json';

export function getStaticPaths() {
  return places.filter((place) => place.status === 'active' && place.visibility !== 'suppressed').map((place) => ({ params: { slug: place.slug }, props: { place } }));
}
const { place } = Astro.props;
const operatorUrl = place.officialSource?.url || place.website || null;
const directionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place.name} ${place.town || ''} Tasmania`)}`;
const reviewUrl = place.reviewLinks?.find((item) => item.provider === 'google-maps')?.url || directionsUrl;
const bookingUrl = place.bookingUrl || null;
const phoneHref = place.phone ? `tel:${String(place.phone).replace(/[^+\d]/g, '')}` : null;
const feeText = place.fee === 'no' ? 'Free entry' : place.fee === 'yes' ? 'Entry fee may apply' : place.fee || null;
const wheelchairText = place.wheelchair === 'yes' ? 'Wheelchair accessible' : place.wheelchair === 'limited' ? 'Limited wheelchair access' : place.wheelchair === 'no' ? 'Not marked wheelchair accessible' : null;
const googleMapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || '';
const prettyHours = (value = '') => String(value)
  .replace(/\bMo\b/g, 'Mon').replace(/\bTu\b/g, 'Tue').replace(/\bWe\b/g, 'Wed')
  .replace(/\bTh\b/g, 'Thu').replace(/\bFr\b/g, 'Fri').replace(/\bSa\b/g, 'Sat').replace(/\bSu\b/g, 'Sun')
  .replace(/;/g, '; ');
const dayNumber = { Sunday: 0, Monday: 1, Tuesday: 2, Wednesday: 3, Thursday: 4, Friday: 5, Saturday: 6 };
function hobartTodayUtc() {
  const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Australia/Hobart', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
  const get = (type) => Number(parts.find((part) => part.type === type)?.value || 0);
  return new Date(Date.UTC(get('year'), get('month') - 1, get('day'), 12));
}
function upcomingScheduleDates(schedule, limit = 8) {
  if (!schedule?.frequency) return [];
  const start = hobartTodayUtc();
  const dates = [];
  const wantedDays = new Set((schedule.daysOfWeek || []).map((day) => dayNumber[day]).filter((day) => Number.isInteger(day)));
  for (let offset = 0; offset < 120 && dates.length < limit; offset++) {
    const date = new Date(start);
    date.setUTCDate(start.getUTCDate() + offset);
    if (schedule.frequency === 'daily' || (schedule.frequency === 'weekly' && wantedDays.has(date.getUTCDay()))) dates.push(date);
  }
  return dates;
}
const upcomingDates = upcomingScheduleDates(place.schedule);
const formatDate = (date) => new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Hobart', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }).format(date);
const allSchemaImages = [place.image, ...(place.gallery || [])].filter(Boolean).map((image) => image.url.startsWith('http') ? image.url : new URL(image.url, Astro.site ?? Astro.url.origin).href);
const schema = {
  '@context': 'https://schema.org', '@type': 'TouristAttraction', name: place.name,
  description: place.summary, url: new URL(`/place/${place.slug}/`, Astro.site ?? Astro.url.origin).href,
  image: allSchemaImages,
  geo: { '@type': 'GeoCoordinates', latitude: place.latitude, longitude: place.longitude },
  address: { '@type': 'PostalAddress', streetAddress: place.address || undefined, addressLocality: place.town, addressRegion: 'TAS', addressCountry: 'AU' },
  openingHours: place.openingHours || undefined,
  telephone: place.phone || undefined,
  email: place.email || undefined,
  sameAs: operatorUrl ? [operatorUrl] : undefined
};
---
<BaseLayout title={`${place.name} | TassieNow`} description={place.summary} image={place.image.url}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <article class="content-page">
    <p class="eyebrow">{place.town} · {place.region}</p>
    <h1>{place.name}</h1>
    <figure class="detail-image-wrap">
      <img class="detail-image" src={place.image.url} alt={place.image.alt} />
      {!place.image.isFallback && <figcaption>Image: {place.image.attribution} · {place.image.license}</figcaption>}
    </figure>

    {place.gallery?.length > 0 && (
      <section class="gallery-section" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading">More photos</h2>
        <div class="photo-grid">
          {place.gallery.map((image) => (
            <figure>
              <a href={image.url} target="_blank" rel="noopener noreferrer"><img src={image.url} alt={image.alt || `${place.name}, Tasmania`} loading="lazy" /></a>
              <figcaption>{image.attribution} · {image.license}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <div class="detail-meta">{place.categories.map((category) => <span class="tag">{category}</span>)}</div>
    <p>{place.summary}</p>

    {(place.openingHours || place.schedule?.summary || place.phone || place.email || place.address || feeText || wheelchairText || place.operator) && (
      <section class="visit-card" aria-labelledby="visit-heading">
        <h2 id="visit-heading">Plan your visit</h2>
        <div class="visit-grid">
          {place.openingHours && <div><span>Opening hours</span><strong>{prettyHours(place.openingHours)}</strong></div>}
          {place.schedule?.summary && <div class="wide"><span>When it is on</span><strong>{place.schedule.summary}</strong>{place.schedule.sourceUrl && <small><a href={place.schedule.sourceUrl} target="_blank" rel="noopener noreferrer">Official dates ↗</a></small>}</div>}
          {place.address && <div><span>Address</span><strong>{place.address}</strong></div>}
          {place.phone && <div><span>Phone</span><strong><a href={phoneHref}>{place.phone}</a></strong></div>}
          {place.email && <div><span>Email</span><strong><a href={`mailto:${place.email}`}>{place.email}</a></strong></div>}
          {feeText && <div><span>Entry</span><strong>{feeText}</strong></div>}
          {wheelchairText && <div><span>Accessibility</span><strong>{wheelchairText}</strong></div>}
          {place.operator && <div><span>Operator</span><strong>{place.operator}</strong></div>}
        </div>
        {upcomingDates.length > 0 && (
          <div class="upcoming-dates">
            <span>Next dates</span>
            <div>{upcomingDates.map((date) => <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>)}</div>
            {place.schedule?.notes && <p>{place.schedule.notes}</p>}
          </div>
        )}
      </section>
    )}

    {place.walk && <p><strong>Walk details:</strong> {place.walk.duration || 'See official listing'}{place.walk.grade ? ` · Grade ${place.walk.grade}` : ''}</p>}
    <div class="action-row">
      {operatorUrl && <a class="action-link" href={operatorUrl} target="_blank" rel="noopener noreferrer">Official website ↗</a>}
      {bookingUrl && <a class="action-link" href={bookingUrl} target="_blank" rel="noopener noreferrer">Bookings ↗</a>}
      <a class="action-link secondary" href={directionsUrl} target="_blank" rel="noopener noreferrer">Map & directions ↗</a>
      <a class="action-link secondary" href={reviewUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a>
    </div>

    {googleMapsApiKey && (
      <section class="google-card" aria-labelledby="google-heading">
        <div class="google-heading-row">
          <div>
            <p class="eyebrow">Live Google information</p>
            <h2 id="google-heading">Ratings, reviews & visitor photos</h2>
          </div>
          <a href={reviewUrl} target="_blank" rel="noopener noreferrer">View on Google Maps ↗</a>
        </div>
        <gmp-place-details>
          {place.googlePlaceId
            ? <gmp-place-details-place-request place={place.googlePlaceId}></gmp-place-details-place-request>
            : <gmp-place-details-location-request location={`${place.latitude},${place.longitude}`}></gmp-place-details-location-request>}
          <gmp-place-content-config>
            <gmp-place-media lightbox-preferred></gmp-place-media>
            <gmp-place-rating></gmp-place-rating>
            <gmp-place-open-now-status></gmp-place-open-now-status>
            <gmp-place-opening-hours></gmp-place-opening-hours>
            <gmp-place-reviews></gmp-place-reviews>
            <gmp-place-attribution light-scheme-color="gray" dark-scheme-color="white"></gmp-place-attribution>
          </gmp-place-content-config>
        </gmp-place-details>
      </section>
    )}

    <p class="notice">Opening hours, market dates, prices, bookings, conditions and access details can change. TassieNow records sourced information where available; confirm time-sensitive details with the operator before travelling.</p>
    <p class="source-note">
      Data source: <a href={place.sourceUrl} target="_blank" rel="noopener noreferrer">source record ↗</a>
      {place.officialSource?.name ? <> · Official enrichment: <a href={place.officialSource.url} target="_blank" rel="noopener noreferrer">{place.officialSource.name} ↗</a></> : ''}
      {place.lastDetailsChecked ? <> · Details checked <strong>{place.lastDetailsChecked}</strong></> : <> · Last checked <strong>{place.lastChecked}</strong></>}
    </p>
    <p><a href={`/town/${place.town.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`}>More around {place.town} →</a></p>
  </article>

  {googleMapsApiKey && (
    <script is:inline define:vars={{ googleMapsApiKey }}>
      (g=>{var h,a,k,p="The Google Maps JavaScript API",c="google",l="importLibrary",q="__ib__",m=document,b=window;b=b[c]||(b[c]={});var d=b.maps||(b.maps={}),r=new Set,e=new URLSearchParams,u=()=>h||(h=new Promise(async(f,n)=>{await(a=m.createElement("script"));e.set("libraries",[...r]+"");for(k in g)e.set(k.replace(/[A-Z]/g,t=>"_"+t[0].toLowerCase()),g[k]);e.set("callback",c+".maps."+q);a.src=`https://maps.${c}apis.com/maps/api/js?`+e;d[q]=f;a.onerror=()=>h=n(Error(p+" could not load."));a.nonce=m.querySelector("script[nonce]")?.nonce||"";m.head.append(a)}));d[l]?console.warn(p+" only loads once. Ignoring:",g):d[l]=(f,...n)=>r.add(f)&&u().then(()=>d[l](f,...n))})({key:googleMapsApiKey,v:"weekly"});
      google.maps.importLibrary('places');
    </script>
  )}

  <style>
    .visit-card,.google-card{margin:1.5rem 0;padding:1.2rem;border:1px solid #dce5e7;border-radius:18px;background:#f8fbfb}.visit-card h2,.google-card h2,.gallery-section h2{margin:0 0 1rem}.visit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem}.visit-grid>div{display:grid;gap:.2rem;padding:.8rem;background:#fff;border:1px solid #e3ebec;border-radius:12px}.visit-grid>div.wide{grid-column:1/-1}.visit-grid span,.upcoming-dates>span{font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:#66787a}.visit-grid strong{font-size:.95rem;color:#173f43}.visit-grid a,.google-card a{color:#027B87}.visit-grid small{font-size:.8rem}.upcoming-dates{margin-top:1rem;padding-top:1rem;border-top:1px solid #dce5e7}.upcoming-dates>div{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.5rem}.upcoming-dates time{padding:.45rem .65rem;border-radius:999px;background:#fff;border:1px solid #dce5e7;font-size:.85rem;font-weight:700;color:#173f43}.upcoming-dates p{margin:.7rem 0 0;font-size:.86rem;color:#53686a}.action-row{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.2rem 0}.gallery-section{margin:1.3rem 0}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.photo-grid figure{margin:0}.photo-grid img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px;display:block}.photo-grid figcaption{margin-top:.35rem;font-size:.72rem;color:#66787a}.google-heading-row{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.google-heading-row h2{margin:.1rem 0 .5rem}.google-card gmp-place-details{display:block;width:min(100%,400px);height:560px;margin-top:1rem;color-scheme:light}@media(max-width:700px){.visit-grid{grid-template-columns:1fr}.photo-grid{grid-template-columns:1fr}.google-heading-row{display:block}.google-card gmp-place-details{width:100%;height:620px}}
  </style>
</BaseLayout>
