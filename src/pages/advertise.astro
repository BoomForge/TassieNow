---
import BaseLayout from '../layouts/BaseLayout.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<BaseLayout title="Advertise on TassieNow" description="Reach Tasmanians and visitors who are actively looking for things to do, places to visit and local experiences across Tasmania.">
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <section class="content-shell advertise-page">
    <p class="eyebrow">Advertise with TassieNow</p>
    <h1>Reach people looking for what Tasmania offers.</h1>
    <p class="hero-copy">TassieNow is built around high-intent local discovery: where to go, what to do, what’s on and what’s nearby. Advertising placements are clearly labelled and scheduled for specific campaigns.</p>

    <div class="advertise-grid">
      <article class="info-card featured-card">
        <p class="placement-label">Highest visibility</p>
        <h2>Homepage top</h2>
        <p>High-visibility banner shown near the main discovery entry point.</p>
        <p class="artwork-size"><strong>Artwork:</strong> 1120 × 180 px</p>
        <div class="price-row"><span><strong>$50</strong><small>7 days</small></span><span><strong>$149</strong><small>30 days</small></span></div>
      </article>
      <article class="info-card">
        <h2>Homepage inline</h2>
        <p>Placed inside the discovery experience without disguising advertising as a listing.</p>
        <p class="artwork-size"><strong>Artwork:</strong> 1120 × 180 px</p>
        <div class="price-row"><span><strong>$35</strong><small>7 days</small></span><span><strong>$99</strong><small>30 days</small></span></div>
      </article>
      <article class="info-card">
        <h2>Site footer</h2>
        <p>Broad site-wide exposure across place, event, town and region pages.</p>
        <p class="artwork-size"><strong>Artwork:</strong> 1120 × 180 px</p>
        <div class="price-row"><span><strong>$20</strong><small>7 days</small></span><span><strong>$49</strong><small>30 days</small></span></div>
      </article>
    </div>

    <div class="rate-note">
      <strong>Launch pricing in AUD.</strong> Founding advertisers who continue renewing can retain these launch rates for 12 months from their first paid campaign. GST is added only if applicable.
    </div>

    <section class="guidelines-panel">
      <div>
        <p class="eyebrow">Advertising guidelines</p>
        <h2>We design it first. You approve it before you pay.</h2>
      </div>
      <div class="guideline-steps">
        <article><strong>1. Send the brief</strong><p>Choose a package and tell us what you want to promote. Supply your logo, preferred images, key message and destination website where available.</p></article>
        <article><strong>2. TassieNow designs the advertisement</strong><p>We prepare the banner artwork to the required 1120 × 180 px format so it fits the selected TassieNow placement correctly.</p></article>
        <article><strong>3. You approve the finished ad</strong><p>The completed advertisement is submitted to you for approval. Changes can be requested before approval.</p></article>
        <article><strong>4. Payment comes after approval</strong><p>No payment is requested before you approve the advertisement. Once approved, we send the PayPal transfer details.</p></article>
        <article><strong>5. We schedule the campaign</strong><p>After payment is received, the approved advertisement is scheduled for the purchased 7-day or 30-day campaign window and automatically stops at the end of that period.</p></article>
      </div>
    </section>

    <div class="payment-note">
      <div><p class="eyebrow">Payment</p><h2>PayPal transfer</h2></div>
      <p>PayPal transfer is TassieNow’s primary payment option for now. No payment is taken when you submit an enquiry. Payment is requested only after the finished advertisement has been designed and approved by you, and the campaign is scheduled after payment is received.</p>
    </div>

    <section class="form-panel">
      <h2>Advertising enquiry</h2>
      <p>Choose a package, tell us what you want to promote, and pick a preferred start date. We will design the advertisement and send it to you for approval before requesting payment.</p>
      <form id="advertise-form">
        <div class="form-grid">
          <label>Your name<input name="name" required maxlength="120" /></label>
          <label>Business / organisation<input name="business" required maxlength="160" /></label>
          <label>Email<input name="email" type="email" required maxlength="180" /></label>
          <label>Phone (optional)<input name="phone" maxlength="80" /></label>
          <label>Website (optional)<input name="website" type="url" placeholder="https://" /></label>
          <label>Advertising package<select name="package_code" required><option value="">Choose a package…</option><optgroup label="Homepage top · 1120 × 180 px"><option value="homepage-top-7">Homepage top · 7 days · $50 AUD</option><option value="homepage-top-30">Homepage top · 30 days · $149 AUD</option></optgroup><optgroup label="Homepage inline · 1120 × 180 px"><option value="homepage-inline-7">Homepage inline · 7 days · $35 AUD</option><option value="homepage-inline-30">Homepage inline · 30 days · $99 AUD</option></optgroup><optgroup label="Site footer · 1120 × 180 px"><option value="site-footer-7">Site footer · 7 days · $20 AUD</option><option value="site-footer-30">Site footer · 30 days · $49 AUD</option></optgroup></select></label>
          <label>Preferred start date<input name="desired_start" type="date" /></label>
          <label>Payment method<input value="PayPal transfer" disabled /><small>Payment details are sent only after you approve the finished advertisement.</small></label>
        </div>
        <label class="full-field">What would you like to promote?<textarea name="message" required rows="6" maxlength="2500" placeholder="Tell us the offer, event, product or message you want the advertisement to communicate. You can provide logos and images during the approval process."></textarea></label>
        <label class="honeypot" aria-hidden="true">Company URL<input name="company_url" tabindex="-1" autocomplete="off" /></label>
        {turnstileSiteKey && <div class="turnstile-row"><div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div></div>}
        <div class="form-actions"><button class="primary-button" type="submit">Send enquiry</button><span id="advertise-status" aria-live="polite"></span></div>
      </form>
    </section>
  </section>

  <script>
    const form = document.querySelector('#advertise-form');
    const status = document.querySelector('#advertise-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault(); status.textContent = 'Sending…';
      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const response = await fetch('/api/advertise', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Could not send enquiry');
        form.reset(); window.turnstile?.reset(); status.textContent = `Thanks — your ${result.package?.durationDays || ''}-day advertising enquiry has been sent. We will prepare the advertisement for your approval before requesting payment.`;
      } catch (error) { window.turnstile?.reset(); status.textContent = error.message || 'Could not send enquiry. Please try again.'; }
    });
  </script>
  <style>
    .advertise-page{padding:3rem 1.25rem 5rem}.advertise-page h1{max-width:820px}.advertise-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0}.info-card,.form-panel,.rate-note,.payment-note,.guidelines-panel{background:#fff;border:1px solid #dce5e7;border-radius:18px;padding:1.25rem;box-shadow:0 10px 30px rgba(6,45,50,.05)}.info-card h2{font-size:1.1rem;margin:.15rem 0}.featured-card{border-color:#7bb9bd}.placement-label{margin:0;color:#027B87;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.artwork-size{margin:.85rem 0 0;color:#536568;font-size:.9rem}.price-row{display:flex;gap:.75rem;margin-top:1rem}.price-row span{display:grid;flex:1;background:#f1f7f7;border-radius:12px;padding:.7rem}.price-row strong{font-size:1.45rem;color:#0b5056}.price-row small{color:#66787a}.rate-note{margin:-.5rem 0 1rem;background:#f7fbfb}.guidelines-panel{margin:1rem 0 2rem}.guidelines-panel h2{margin:.2rem 0 1rem}.guideline-steps{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.8rem}.guideline-steps article{background:#f7fbfb;border:1px solid #e1ebec;border-radius:14px;padding:.9rem}.guideline-steps strong{color:#0b5056}.guideline-steps p{margin:.45rem 0 0;color:#536568;font-size:.88rem;line-height:1.45}.payment-note{display:grid;grid-template-columns:minmax(180px,.4fr) 1fr;gap:1.5rem;align-items:center;margin:1rem 0 2rem}.payment-note h2{margin:.15rem 0}.payment-note p{margin:0}.form-panel{max-width:900px}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.form-panel label{display:grid;gap:.4rem;font-weight:700;color:#173f43}.form-panel label small{font-weight:400;color:#66787a}.form-panel input,.form-panel select,.form-panel textarea{width:100%;box-sizing:border-box;border:1px solid #bccdce;border-radius:10px;padding:.8rem;font:inherit;background:#fff}.form-panel input:disabled{background:#f3f7f7;color:#536568}.full-field{margin-top:1rem}.turnstile-row{margin-top:1rem;min-height:65px}.form-actions{display:flex;gap:1rem;align-items:center;margin-top:1rem}.honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;overflow:hidden!important}@media(max-width:1050px){.guideline-steps{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.advertise-grid,.form-grid,.payment-note,.guideline-steps{grid-template-columns:1fr}}
  </style>
</BaseLayout>
