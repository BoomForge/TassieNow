---
import BaseLayout from '../../layouts/BaseLayout.astro';
import events from '../../data/events.json';
export function getStaticPaths(){return events.filter((e)=>e.status==='active').map((event)=>({params:{slug:event.slug},props:{event}}));}
const { event }=Astro.props;
const schema={'@context':'https://schema.org','@type':'Event',name:event.name,startDate:event.startDate,endDate:event.endDate,description:event.summary,url:event.eventUrl||event.sourceUrl,location:{'@type':'Place',name:event.town,address:{'@type':'PostalAddress',addressLocality:event.town,addressRegion:'TAS',addressCountry:'AU'}},image:[event.image.url.startsWith('http')?event.image.url:new URL(event.image.url,Astro.site??Astro.url.origin).href]};
---
<BaseLayout title={`${event.name} | TassieNow`} description={event.summary} image={event.image.url}><script type="application/ld+json" set:html={JSON.stringify(schema)}></script><article class="content-page"><p class="eyebrow">{event.town} · {event.region}</p><h1>{event.name}</h1><figure class="detail-image-wrap"><img class="detail-image" src={event.image.url} alt={event.image.alt}/>{!event.image.isFallback&&<figcaption>Image: {event.image.attribution} · {event.image.license}</figcaption>}</figure><p class="event-date"><strong>{event.startDate}</strong>{event.endDate!==event.startDate&&<> to <strong>{event.endDate}</strong></>}</p><div class="detail-meta">{event.categories.map((c)=><span class="tag">{c}</span>)}</div><p>{event.summary}</p><div class="action-row"><a class="action-link" href={event.eventUrl||event.sourceUrl} target="_blank" rel="noopener noreferrer">Official event details ↗</a></div><p class="notice">Event times, availability and venues can change. Confirm details with the official source before travelling.</p><p>Source: {event.sourceName||'Official event source'} · Last checked <strong>{event.lastChecked}</strong></p></article></BaseLayout>
