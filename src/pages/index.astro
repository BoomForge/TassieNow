---
import BaseLayout from '../layouts/BaseLayout.astro';
import places from '../data/places.json';
import events from '../data/events.json';

function hobartDate(date = new Date()) {
  const parts = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Hobart', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(date);
  const get = (type) => parts.find((part) => part.type === type)?.value;
  return `${get('year')}-${get('month')}-${get('day')}`;
}
const today = hobartDate();
const activePlaces = places.filter((place) => place.status === 'active');
const activeEvents = events.filter((event) => event.status === 'active' && event.endDate >= today);
const regions = [...new Set(activePlaces.map((place) => place.region))].sort();
const towns = [...new Set(activePlaces.map((place) => place.town))].sort();
const categories = [...new Set(activePlaces.flatMap((place) => place.categories))].sort();
const quickModes = [
  ['kids', 'Kids'], ['free', 'Free'], ['rainy-day', 'Rainy Day'], ['today', 'Today'],
  ['this-weekend', 'This Weekend'], ['markets', 'Markets'], ['nature', 'Nature'], ['food', 'Food & Produce']
];
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Tasmania, without the digging</p>
    <h1>Find something to do.</h1>
    <p class="hero-copy">Discover attractions, walks, markets, museums, family activities, local produce and current events across Tasmania.</p>
    <div class="hero-actions">
      <a class="primary-button link-button" href="#explore">Explore Tasmania</a>
      <button class="secondary-button" id="surprise-me" type="button">Surprise me</button>
    </div>
  </section>

  <section class="directory" id="explore">
    <div class="mode-grid" aria-label="Popular discovery modes">
      {quickModes.map(([slug, label]) => <a class="mode-card" href={`/discover/${slug}/`}>{label}<span>→</span></a>)}
    </div>

    <div class="stats-strip">
      <strong>{activePlaces.length}</strong> places · <strong>{activeEvents.length}</strong> current events · <strong>{towns.length}</strong> towns
    </div>

    <div class="control-panel" aria-label="Directory filters">
      <input id="search" type="search" placeholder="Search places, towns or interests…" aria-label="Search places" />
      <select id="region" aria-label="Filter by region">
        <option value="">All regions</option>
        {regions.map((region) => <option value={region.toLowerCase()}>{region}</option>)}
      </select>
      <select id="category" aria-label="Filter by category">
        <option value="">Everything</option>
        {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
      </select>
      <button class="primary-button" id="near-me" type="button">Near me</button>
    </div>
    <p class="status-line" id="location-status" aria-live="polite">Search the live catalogue or sort places by distance from you.</p>

    <div class="section-heading" id="places">
      <h2>Explore Tasmania</h2>
      <span class="result-count"><span id="result-count">{activePlaces.length}</span> places</span>
    </div>

    <div class="place-grid" id="place-grid">
      {activePlaces.map((place) => (
        <article class="place-card" data-name={place.name.toLowerCase()} data-town={place.town.toLowerCase()} data-region={place.region.toLowerCase()} data-categories={place.categories.map((category) => category.toLowerCase()).join('|')} data-lat={place.latitude} data-lon={place.longitude} data-distance="">
          <a class="card-image-link" href={`/place/${place.slug}/`} aria-label={`View ${place.name}`}>
            <img class="card-image" src={place.image.url} alt={place.image.alt} loading="lazy" decoding="async" />
            <span class="image-badge">{place.categories[0]}</span>
          </a>
          <div class="card-body">
            <p class="location"><a href={`/town/${place.town.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`}>{place.town}</a> · <a href={`/region/${place.region.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`}>{place.region}</a></p>
            <h3>{place.name}</h3>
            <p class="summary">{place.summary}</p>
            <div class="tags">{place.categories.slice(0, 4).map((category) => <span class="tag">{category}</span>)}</div>
            <div class="card-footer"><a class="card-link" href={`/place/${place.slug}/`}>View place →</a><span class="distance" aria-live="polite"></span></div>
          </div>
        </article>
      ))}
    </div>
    <div class="empty-state" id="empty-state">No places match those filters yet. Try broadening the search.</div>
  </section>

  <script>
    const search = document.querySelector('#search');
    const region = document.querySelector('#region');
    const category = document.querySelector('#category');
    const cards = [...document.querySelectorAll('.place-card')];
    const count = document.querySelector('#result-count');
    const emptyState = document.querySelector('#empty-state');
    const nearMe = document.querySelector('#near-me');
    const surprise = document.querySelector('#surprise-me');
    const locationStatus = document.querySelector('#location-status');

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const regionValue = region.value;
      const categoryValue = category.value;
      let visible = 0;
      cards.forEach((card) => {
        const haystack = `${card.dataset.name} ${card.dataset.town} ${card.dataset.region} ${card.dataset.categories}`;
        const show = (!query || haystack.includes(query)) && (!regionValue || card.dataset.region === regionValue) && (!categoryValue || card.dataset.categories.split('|').includes(categoryValue));
        card.hidden = !show;
        if (show) visible += 1;
      });
      count.textContent = String(visible);
      emptyState.style.display = visible === 0 ? 'block' : 'none';
    }
    search.addEventListener('input', applyFilters);
    region.addEventListener('change', applyFilters);
    category.addEventListener('change', applyFilters);

    function distanceKm(lat1, lon1, lat2, lon2) {
      const rad = (value) => value * Math.PI / 180, r = 6371;
      const dLat = rad(lat2 - lat1), dLon = rad(lon2 - lon1);
      const a = Math.sin(dLat / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLon / 2) ** 2;
      return r * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }
    nearMe.addEventListener('click', () => {
      if (!navigator.geolocation) { locationStatus.textContent = 'Location is not supported by this browser.'; return; }
      locationStatus.textContent = 'Finding your location…';
      navigator.geolocation.getCurrentPosition(({ coords }) => {
        cards.forEach((card) => {
          const distance = distanceKm(coords.latitude, coords.longitude, Number(card.dataset.lat), Number(card.dataset.lon));
          card.dataset.distance = String(distance);
          card.querySelector('.distance').textContent = `${distance.toFixed(distance < 10 ? 1 : 0)} km away`;
        });
        const grid = document.querySelector('#place-grid');
        cards.sort((a, b) => Number(a.dataset.distance) - Number(b.dataset.distance)).forEach((card) => grid.appendChild(card));
        locationStatus.textContent = 'Sorted by straight-line distance from your current location.';
        applyFilters();
      }, () => { locationStatus.textContent = 'Location access was unavailable. Search by town or region instead.'; }, { timeout: 8000, maximumAge: 300000 });
    });
    surprise.addEventListener('click', () => {
      const visible = cards.filter((card) => !card.hidden);
      const pool = visible.length ? visible : cards;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      pick?.querySelector('.card-link')?.click();
    });
    document.querySelectorAll('.card-image').forEach((img) => img.addEventListener('error', () => { img.src = '/images/categories/discover.svg'; }, { once: true }));
  </script>
</BaseLayout>
