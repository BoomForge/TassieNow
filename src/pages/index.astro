---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import places from '../data/places.json';
import events from '../data/events.json';

function hobartDate(date = new Date()) {
  const parts = new Intl.DateTimeFormat('en-AU', {
    timeZone: 'Australia/Hobart',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(date);
  const get = (type) => parts.find((part) => part.type === type)?.value;
  return `${get('year')}-${get('month')}-${get('day')}`;
}

const slugify = (value = '') => String(value)
  .toLowerCase()
  .replace(/&/g, 'and')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const today = hobartDate();
const activePlaces = places
  .filter((place) => place.status === 'active' && place.visibility !== 'suppressed')
  .sort((a, b) =>
    Number(Boolean(b.featured)) - Number(Boolean(a.featured)) ||
    (b.qualityScore || 0) - (a.qualityScore || 0) ||
    a.name.localeCompare(b.name)
  );

const activeEvents = events
  .filter((event) => event.status === 'active' && event.endDate >= today)
  .sort((a, b) => a.startDate.localeCompare(b.startDate) || (a.name || '').localeCompare(b.name || ''));

const regions = [...new Set(activePlaces.map((place) => place.region).filter(Boolean))].sort();
const towns = [...new Set(activePlaces.map((place) => place.town).filter(Boolean))].sort();
const categories = [...new Set(activePlaces.flatMap((place) => place.categories || []))].sort();

const quickModes = [
  { slug: 'today', label: 'Today', copy: 'See what is on and open now.', icon: '☀' },
  { slug: 'this-weekend', label: 'This weekend', copy: 'Make a plan without digging.', icon: '↗' },
  { slug: 'kids', label: 'Kids', copy: 'Family-friendly places and activities.', icon: '★' },
  { slug: 'free', label: 'Free', copy: 'Good days out that cost nothing.', icon: '$0' },
  { slug: 'rainy-day', label: 'Rainy day', copy: 'Indoor ideas for Tassie weather.', icon: '☂' },
  { slug: 'markets', label: 'Markets', copy: 'Produce, makers and local favourites.', icon: '◫' },
  { slug: 'nature', label: 'Walks & nature', copy: 'Trails, lookouts and wild places.', icon: '△' },
  { slug: 'food', label: 'Food & produce', copy: 'Local flavours worth a detour.', icon: '●' }
];

const featuredPlaces = [
  ...activePlaces.filter((place) => !place.image?.isFallback),
  ...activePlaces.filter((place) => place.image?.isFallback)
].filter((place, index, array) => array.findIndex((item) => item.slug === place.slug) === index).slice(0, 6);

const upcomingEvents = activeEvents.slice(0, 4);

const regionCards = regions.map((region) => {
  const regionPlaces = activePlaces.filter((place) => place.region === region);
  const imagePlace = regionPlaces.find((place) => !place.image?.isFallback) || regionPlaces[0];
  return {
    region,
    slug: slugify(region),
    count: regionPlaces.length,
    image: imagePlace?.image || null
  };
});

const formatEventDate = (startDate, endDate) => {
  const start = new Date(`${startDate}T12:00:00Z`);
  const end = new Date(`${endDate}T12:00:00Z`);
  const formatter = new Intl.DateTimeFormat('en-AU', {
    timeZone: 'Australia/Hobart',
    day: 'numeric',
    month: 'short'
  });
  if (startDate === endDate) return formatter.format(start);
  return `${formatter.format(start)} – ${formatter.format(end)}`;
};
---

<BaseLayout>
  <section class="home-hero">
    <div class="hero-copy-block">
      <p class="eyebrow">Tasmania, without the digging</p>
      <h1>What do you feel like doing?</h1>
      <p class="home-hero-copy">
        Find genuinely useful places, things to do and current events across Tasmania — then narrow it down by mood, region, interest or distance.
      </p>
      <div class="hero-trust">
        <span><strong>{activePlaces.length}</strong> useful places</span>
        <span><strong>{activeEvents.length}</strong> current events</span>
        <span><strong>{towns.length}</strong> towns</span>
      </div>
    </div>

    <div class="planner-card" aria-label="Plan something in Tasmania">
      <p class="planner-kicker">Start here</p>
      <h2>Find an idea fast</h2>
      <label class="planner-search">
        <span class="sr-only">Search TassieNow</span>
        <input id="hero-search" type="search" placeholder="Search a town, place or interest…" autocomplete="off" />
        <button id="hero-search-button" type="button">Search</button>
      </label>
      <div class="planner-actions">
        <a href="/discover/today/">What’s on today</a>
        <a href="/discover/this-weekend/">This weekend</a>
        <button id="hero-near-me" type="button">Near me</button>
        <button id="surprise-me" type="button">Surprise me</button>
      </div>
      <p class="planner-note" id="hero-location-status" aria-live="polite">
        No login. No app. Just useful Tasmanian ideas.
      </p>
    </div>
  </section>

  <AdSlot placement="homepage-top" />

  <main class="home-shell">
    <section class="home-section intent-section" aria-labelledby="intent-heading">
      <div class="home-section-heading">
        <div>
          <p class="section-kicker">Choose your kind of day</p>
          <h2 id="intent-heading">Browse by what you need</h2>
        </div>
        <p>Skip the research. Start with the kind of day you actually want.</p>
      </div>

      <div class="intent-grid">
        {quickModes.map((mode) => (
          <a class="intent-card" href={`/discover/${mode.slug}/`}>
            <span class="intent-icon" aria-hidden="true">{mode.icon}</span>
            <span class="intent-copy">
              <strong>{mode.label}</strong>
              <small>{mode.copy}</small>
            </span>
            <span class="intent-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="featured-heading">
      <div class="home-section-heading split-heading">
        <div>
          <p class="section-kicker">A good place to start</p>
          <h2 id="featured-heading">Worth a look</h2>
        </div>
        <a class="text-link" href="#directory">Search the full catalogue →</a>
      </div>

      <div class="featured-grid">
        {featuredPlaces.map((place, index) => (
          <article class:list={['featured-card', index === 0 && 'featured-card-large']}>
            <a href={`/place/${place.slug}/`} class="featured-image-link" aria-label={`View ${place.name}`}>
              <img
                src={place.image?.url || '/images/categories/discover.svg'}
                alt={place.image?.alt || `${place.name}, Tasmania`}
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="featured-overlay"></span>
              <span class="featured-category">{place.categories?.[0] || 'Discover'}</span>
              <div class="featured-copy">
                <p>{place.town} · {place.region}</p>
                <h3>{place.name}</h3>
                <span>Explore →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    {upcomingEvents.length > 0 && (
      <section class="home-section event-section" aria-labelledby="events-heading">
        <div class="home-section-heading split-heading">
          <div>
            <p class="section-kicker">Current & coming up</p>
            <h2 id="events-heading">What’s happening</h2>
          </div>
          <a class="text-link" href="/discover/today/">See today →</a>
        </div>

        <div class="event-grid">
          {upcomingEvents.map((event) => (
            <article class="event-card">
              <a class="event-card-image" href={`/event/${event.slug}/`}>
                <img
                  src={event.image?.url || '/images/categories/events.svg'}
                  alt={event.image?.alt || `${event.name}, Tasmania`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="event-card-body">
                <div class="event-meta">
                  <span>{formatEventDate(event.startDate, event.endDate)}</span>
                  <span>{event.town}</span>
                </div>
                <h3><a href={`/event/${event.slug}/`}>{event.name}</a></h3>
                <p>{event.summary}</p>
                <a class="event-link" href={`/event/${event.slug}/`}>View event →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <AdSlot placement="homepage-inline" />

    <section class="home-section" aria-labelledby="regions-heading">
      <div class="home-section-heading">
        <div>
          <p class="section-kicker">Explore geographically</p>
          <h2 id="regions-heading">Pick a part of Tasmania</h2>
        </div>
        <p>Useful when you already know roughly where the day is taking you.</p>
      </div>

      <div class="region-grid">
        {regionCards.map((item) => (
          <a class="region-card" href={`/region/${item.slug}/`}>
            {item.image && <img src={item.image.url} alt="" loading="lazy" decoding="async" />}
            <span class="region-shade"></span>
            <span class="region-copy">
              <strong>{item.region}</strong>
              <small>{item.count} place{item.count === 1 ? '' : 's'}</small>
            </span>
            <span class="region-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section directory-section" id="directory" aria-labelledby="directory-heading">
      <div class="directory-intro">
        <div>
          <p class="section-kicker">Know what you want?</p>
          <h2 id="directory-heading">Search the full catalogue</h2>
          <p>Search every active TassieNow place, then narrow it by region or category.</p>
        </div>
        <div class="directory-count">
          <strong>{activePlaces.length}</strong>
          <span>active places</span>
        </div>
      </div>

      <div class="control-panel" aria-label="Directory filters">
        <input id="search" type="search" placeholder="Search places, towns or interests…" aria-label="Search places" />
        <select id="region" aria-label="Filter by region">
          <option value="">All regions</option>
          {regions.map((region) => <option value={region.toLowerCase()}>{region}</option>)}
        </select>
        <select id="category" aria-label="Filter by category">
          <option value="">Everything</option>
          {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
        </select>
        <button class="primary-button" id="near-me" type="button">Near me</button>
      </div>

      <div class="directory-status-row">
        <p class="status-line" id="location-status" aria-live="polite">
          Quality-ranked by default. Use Near me to sort by straight-line distance.
        </p>
        <span class="result-count"><strong id="result-count">{activePlaces.length}</strong> matching</span>
      </div>

      <div class="place-grid" id="place-grid">
        {activePlaces.map((place, index) => (
          <article
            class="place-card"
            hidden={index >= 18}
            data-index={index}
            data-name={place.name.toLowerCase()}
            data-town={place.town.toLowerCase()}
            data-region={place.region.toLowerCase()}
            data-categories={(place.categories || []).map((category) => category.toLowerCase()).join('|')}
            data-lat={place.latitude}
            data-lon={place.longitude}
            data-distance=""
          >
            <a class="card-image-link" href={`/place/${place.slug}/`} aria-label={`View ${place.name}`}>
              <img
                class="card-image"
                src={place.image?.url || '/images/categories/discover.svg'}
                alt={place.image?.alt || `${place.name}, Tasmania`}
                loading="lazy"
                decoding="async"
              />
              <span class="image-badge">{place.categories?.[0] || 'Discover'}</span>
            </a>
            <div class="card-body">
              <p class="location">
                <a href={`/town/${slugify(place.town)}/`}>{place.town}</a>
                <span>·</span>
                <a href={`/region/${slugify(place.region)}/`}>{place.region}</a>
              </p>
              <h3><a href={`/place/${place.slug}/`}>{place.name}</a></h3>
              <p class="summary">{place.summary}</p>
              <div class="tags">{(place.categories || []).slice(0, 3).map((category) => <span class="tag">{category}</span>)}</div>
              <div class="card-footer">
                <a class="card-link" href={`/place/${place.slug}/`}>View place →</a>
                <span class="distance" aria-live="polite"></span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="empty-state" id="empty-state">No places match those filters yet. Try broadening the search.</div>

      <div class="load-more-row">
        <button class="secondary-button load-more-button" id="load-more" type="button">
          Show more places
        </button>
      </div>
    </section>
  </main>

  <script>
    const search = document.querySelector('#search');
    const heroSearch = document.querySelector('#hero-search');
    const heroSearchButton = document.querySelector('#hero-search-button');
    const region = document.querySelector('#region');
    const category = document.querySelector('#category');
    const cards = [...document.querySelectorAll('.place-card')];
    const count = document.querySelector('#result-count');
    const emptyState = document.querySelector('#empty-state');
    const nearMe = document.querySelector('#near-me');
    const heroNearMe = document.querySelector('#hero-near-me');
    const surprise = document.querySelector('#surprise-me');
    const locationStatus = document.querySelector('#location-status');
    const heroLocationStatus = document.querySelector('#hero-location-status');
    const loadMore = document.querySelector('#load-more');

    let visibleLimit = 18;
    let distanceSorted = false;

    function hasActiveFilters() {
      return Boolean(search.value.trim() || region.value || category.value || distanceSorted);
    }

    function cardMatches(card) {
      const query = search.value.trim().toLowerCase();
      const regionValue = region.value;
      const categoryValue = category.value;
      const haystack = `${card.dataset.name} ${card.dataset.town} ${card.dataset.region} ${card.dataset.categories}`;
      return (!query || haystack.includes(query))
        && (!regionValue || card.dataset.region === regionValue)
        && (!categoryValue || card.dataset.categories.split('|').includes(categoryValue));
    }

    function applyFilters() {
      const matching = cards.filter(cardMatches);
      const filtered = hasActiveFilters();
      matching.forEach((card, index) => {
        card.hidden = !filtered && index >= visibleLimit;
      });

      cards.filter((card) => !matching.includes(card)).forEach((card) => {
        card.hidden = true;
      });

      count.textContent = String(matching.length);
      emptyState.style.display = matching.length === 0 ? 'block' : 'none';
      loadMore.hidden = filtered || visibleLimit >= matching.length;
    }

    function syncHeroSearch() {
      search.value = heroSearch.value;
      document.querySelector('#directory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.setTimeout(() => {
        search.focus();
        applyFilters();
      }, 350);
    }

    search.addEventListener('input', () => {
      distanceSorted = false;
      applyFilters();
    });
    region.addEventListener('change', applyFilters);
    category.addEventListener('change', applyFilters);

    heroSearchButton.addEventListener('click', syncHeroSearch);
    heroSearch.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') syncHeroSearch();
    });

    loadMore.addEventListener('click', () => {
      visibleLimit += 18;
      applyFilters();
    });

    function distanceKm(lat1, lon1, lat2, lon2) {
      const rad = (value) => value * Math.PI / 180;
      const r = 6371;
      const dLat = rad(lat2 - lat1);
      const dLon = rad(lon2 - lon1);
      const a = Math.sin(dLat / 2) ** 2
        + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLon / 2) ** 2;
      return r * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function sortNearMe(statusTarget = locationStatus) {
      if (!navigator.geolocation) {
        statusTarget.textContent = 'Location is not supported by this browser.';
        return;
      }

      statusTarget.textContent = 'Finding your location…';

      navigator.geolocation.getCurrentPosition(({ coords }) => {
        cards.forEach((card) => {
          const distance = distanceKm(
            coords.latitude,
            coords.longitude,
            Number(card.dataset.lat),
            Number(card.dataset.lon)
          );
          card.dataset.distance = String(distance);
          card.querySelector('.distance').textContent = `${distance.toFixed(distance < 10 ? 1 : 0)} km away`;
        });

        const grid = document.querySelector('#place-grid');
        cards
          .sort((a, b) => Number(a.dataset.distance) - Number(b.dataset.distance))
          .forEach((card) => grid.appendChild(card));

        distanceSorted = true;
        visibleLimit = 18;
        locationStatus.textContent = 'Sorted by straight-line distance from your current location.';
        heroLocationStatus.textContent = 'Nearby places are now at the top of the full catalogue.';
        applyFilters();
        document.querySelector('#directory')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, () => {
        statusTarget.textContent = 'Location access was unavailable. Search by town or region instead.';
      }, { timeout: 8000, maximumAge: 300000 });
    }

    nearMe.addEventListener('click', () => sortNearMe(locationStatus));
    heroNearMe.addEventListener('click', () => sortNearMe(heroLocationStatus));

    surprise.addEventListener('click', () => {
      const pool = cards.filter(cardMatches);
      const picks = pool.length ? pool : cards;
      const pick = picks[Math.floor(Math.random() * picks.length)];
      pick?.querySelector('.card-link')?.click();
    });

    document.querySelectorAll('img').forEach((img) => {
      img.addEventListener('error', () => {
        if (!img.src.endsWith('/images/categories/discover.svg') && !img.src.endsWith('/images/categories/events.svg')) {
          img.src = '/images/categories/discover.svg';
        }
      }, { once: true });
    });

    applyFilters();
  </script>

  <style>
    .sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
    .home-hero{max-width:1180px;margin:0 auto;padding:4.8rem 1.25rem 3rem;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(350px,.85fr);gap:3rem;align-items:center}
    .hero-copy-block h1{max-width:760px;font-size:clamp(3.25rem,7.6vw,6.75rem)}
    .home-hero-copy{max-width:680px;margin:1.45rem 0 0;color:var(--muted);font-size:clamp(1.08rem,2vw,1.28rem);line-height:1.65}
    .hero-trust{display:flex;flex-wrap:wrap;gap:.75rem 1.2rem;margin-top:1.5rem;color:var(--muted);font-size:.88rem}
    .hero-trust span{display:inline-flex;align-items:baseline;gap:.24rem}
    .hero-trust strong{color:var(--ink);font-size:1rem}
    .planner-card{position:relative;padding:1.4rem;border:1px solid rgba(20,70,70,.11);border-radius:1.65rem;background:rgba(255,253,248,.94);box-shadow:0 24px 70px rgba(24,53,52,.13);overflow:hidden}
    .planner-card:before{content:"";position:absolute;inset:0 auto auto 0;width:100%;height:5px;background:linear-gradient(90deg,var(--brand),#36a7ae,var(--accent))}
    .planner-kicker{margin:.2rem 0 .35rem;color:var(--brand-2);font-size:.73rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .planner-card h2{margin:0 0 1rem;font-size:2rem;letter-spacing:-.045em}
    .planner-search{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.55rem}
    .planner-search input{min-width:0;min-height:3.45rem;border:1px solid #c6d4ce;border-radius:.95rem;padding:0 1rem;background:white;color:var(--ink);outline:none}
    .planner-search input:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(2,123,135,.11)}
    .planner-search button{min-height:3.45rem;border:0;border-radius:.95rem;padding:0 1.05rem;background:var(--brand);color:#fff;font-weight:850}
    .planner-actions{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-top:.65rem}
    .planner-actions a,.planner-actions button{display:flex;align-items:center;justify-content:center;min-height:2.9rem;border:1px solid var(--line);border-radius:.82rem;background:#eef3ef;color:var(--ink);text-decoration:none;font-weight:800;font-size:.84rem}
    .planner-actions a:hover,.planner-actions button:hover{border-color:#b7cbc1;background:#e4eee8}
    .planner-note{margin:.85rem .2rem 0;color:var(--muted);font-size:.78rem;line-height:1.45}
    .home-shell{max-width:1180px;margin:0 auto;padding:0 1.25rem 5rem}
    .home-section{margin-top:4.75rem}
    .home-section-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.55fr);gap:2rem;align-items:end;margin-bottom:1.25rem}
    .home-section-heading h2,.directory-intro h2{margin:.12rem 0 0;font-size:clamp(2rem,4vw,3.15rem);letter-spacing:-.05em}
    .home-section-heading>p{margin:0;color:var(--muted);line-height:1.55;text-align:right}
    .section-kicker{margin:0;color:var(--brand-2);font-size:.73rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
    .split-heading{grid-template-columns:minmax(0,1fr) auto}
    .text-link{align-self:end;color:var(--brand);font-size:.9rem;font-weight:850;text-decoration:none}
    .text-link:hover{text-decoration:underline}
    .intent-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}
    .intent-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.8rem;align-items:center;min-height:98px;padding:1rem;border:1px solid var(--line);border-radius:1.1rem;background:rgba(255,253,248,.94);text-decoration:none;box-shadow:0 7px 24px rgba(24,53,52,.035);transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease}
    .intent-card:hover{transform:translateY(-2px);border-color:#b4cbc1;box-shadow:0 14px 30px rgba(24,53,52,.07)}
    .intent-icon{display:grid;place-items:center;width:2.55rem;height:2.55rem;border-radius:.8rem;background:#e6f0ec;color:var(--brand-2);font-size:.9rem;font-weight:900}
    .intent-copy{display:grid;gap:.24rem}
    .intent-copy strong{font-size:.98rem}
    .intent-copy small{color:var(--muted);font-size:.75rem;line-height:1.35}
    .intent-arrow{color:var(--brand);font-weight:900}
    .featured-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(2,210px);gap:.85rem}
    .featured-card{min-width:0}
    .featured-card-large{grid-column:span 2;grid-row:span 2}
    .featured-image-link{position:relative;display:block;width:100%;height:100%;overflow:hidden;border-radius:1.25rem;background:#dce7df;text-decoration:none}
    .featured-image-link img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s ease}
    .featured-image-link:hover img{transform:scale(1.025)}
    .featured-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,24,25,.04) 25%,rgba(7,24,25,.8) 100%)}
    .featured-category{position:absolute;top:.8rem;left:.8rem;padding:.42rem .65rem;border-radius:999px;background:rgba(255,253,248,.92);color:var(--ink);font-size:.7rem;font-weight:850;backdrop-filter:blur(8px)}
    .featured-copy{position:absolute;left:1rem;right:1rem;bottom:1rem;color:white}
    .featured-copy p{margin:0 0 .25rem;color:rgba(255,255,255,.78);font-size:.72rem;font-weight:750}
    .featured-copy h3{margin:0;font-size:1.16rem;letter-spacing:-.025em}
    .featured-card-large .featured-copy h3{font-size:clamp(1.6rem,3vw,2.35rem)}
    .featured-copy span{display:inline-block;margin-top:.45rem;font-size:.78rem;font-weight:850}
    .event-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}
    .event-card{display:grid;grid-template-columns:180px minmax(0,1fr);min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:1.15rem;background:var(--surface);box-shadow:0 8px 25px rgba(24,53,52,.04)}
    .event-card-image{display:block;min-height:190px;background:#dce7df}
    .event-card-image img{width:100%;height:100%;object-fit:cover;display:block}
    .event-card-body{padding:1rem}
    .event-meta{display:flex;flex-wrap:wrap;gap:.35rem .7rem;color:var(--brand-2);font-size:.72rem;font-weight:850;text-transform:uppercase;letter-spacing:.04em}
    .event-card h3{margin:.45rem 0 .45rem;font-size:1.15rem;letter-spacing:-.025em}
    .event-card h3 a{text-decoration:none}
    .event-card p{display:-webkit-box;overflow:hidden;margin:0;color:var(--muted);font-size:.82rem;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:3}
    .event-link{display:inline-block;margin-top:.75rem;color:var(--brand);font-size:.8rem;font-weight:850;text-decoration:none}
    .region-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}
    .region-card{position:relative;min-height:170px;overflow:hidden;border-radius:1.05rem;background:#173f43;color:white;text-decoration:none}
    .region-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .28s ease}
    .region-card:hover img{transform:scale(1.03)}
    .region-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,27,29,.1),rgba(5,27,29,.78))}
    .region-copy{position:absolute;left:1rem;right:2.8rem;bottom:1rem;display:grid;gap:.15rem}
    .region-copy strong{font-size:1.02rem}
    .region-copy small{color:rgba(255,255,255,.75);font-size:.75rem}
    .region-arrow{position:absolute;right:1rem;bottom:1rem;font-weight:900}
    .directory-section{scroll-margin-top:1rem}
    .directory-intro{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:end;margin-bottom:1.2rem}
    .directory-intro>div>p:last-child{max-width:650px;margin:.65rem 0 0;color:var(--muted);line-height:1.55}
    .directory-count{display:grid;justify-items:end}
    .directory-count strong{font-size:2.25rem;line-height:1;color:var(--brand-2)}
    .directory-count span{margin-top:.2rem;color:var(--muted);font-size:.78rem;font-weight:750}
    .directory-status-row{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:.7rem .15rem 1rem}
    .directory-status-row .status-line{margin:0;min-height:0}
    .result-count{white-space:nowrap;color:var(--muted);font-size:.84rem}
    .result-count strong{color:var(--ink)}
    .place-card[hidden]{display:none}
    .place-card h3 a{text-decoration:none}
    .place-card h3 a:hover{color:var(--brand)}
    .load-more-row{display:flex;justify-content:center;margin-top:1.35rem}
    .load-more-button{min-width:180px}
    .load-more-button[hidden]{display:none}
    @media(max-width:980px){
      .home-hero{grid-template-columns:1fr;gap:1.6rem;padding-top:3.5rem}
      .planner-card{max-width:700px}
      .intent-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
      .featured-grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:310px 210px 210px}
      .featured-card-large{grid-column:span 2;grid-row:span 1}
      .region-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media(max-width:760px){
      .home-section{margin-top:3.4rem}
      .home-section-heading,.directory-intro{grid-template-columns:1fr;gap:.75rem;align-items:start}
      .home-section-heading>p{text-align:left;max-width:620px}
      .split-heading{grid-template-columns:1fr auto}
      .event-grid{grid-template-columns:1fr}
      .directory-count{justify-items:start}
      .directory-status-row{align-items:flex-start}
    }
    @media(max-width:600px){
      .home-hero{padding-top:2.6rem;padding-bottom:2rem}
      .hero-copy-block h1{font-size:clamp(3rem,15vw,4.55rem)}
      .planner-card{padding:1rem;border-radius:1.25rem}
      .planner-search{grid-template-columns:1fr}
      .planner-actions{grid-template-columns:1fr 1fr}
      .intent-grid{grid-template-columns:1fr}
      .intent-card{min-height:84px}
      .featured-grid{display:grid;grid-template-columns:1fr;grid-template-rows:none}
      .featured-card,.featured-card-large{grid-column:auto;grid-row:auto;height:245px}
      .event-card{grid-template-columns:115px minmax(0,1fr)}
      .event-card-image{min-height:210px}
      .region-grid{grid-template-columns:1fr 1fr}
      .region-card{min-height:145px}
      .split-heading{grid-template-columns:1fr}
      .text-link{align-self:start}
      .directory-status-row{display:grid;gap:.35rem}
    }
    @media(max-width:420px){
      .planner-actions{grid-template-columns:1fr}
      .region-grid{grid-template-columns:1fr}
      .region-card{min-height:160px}
      .event-card{grid-template-columns:1fr}
      .event-card-image{height:175px;min-height:0}
    }
  </style>
</BaseLayout>
