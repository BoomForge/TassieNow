---
import BaseLayout from '../../layouts/BaseLayout.astro';
import places from '../../data/places.json';
import events from '../../data/events.json';
export function getStaticPaths(){
  const routes = [
    ['kids',{title:'Things to do with kids in Tasmania',categories:['Family']}],
    ['free',{title:'Free things to do in Tasmania',categories:['Free']}],
    ['rainy-day',{title:'Rainy day activities in Tasmania',categories:['Rainy Day']}],
    ['markets',{title:'Markets in Tasmania',categories:['Markets']}],
    ['nature',{title:'Walks and nature in Tasmania',categories:['Nature & Walks']}],
    ['food',{title:'Tasmanian food and local produce',categories:['Food & Drink','Local Produce']}],
    ['today',{title:'What’s on in Tasmania today',eventMode:'today'}],
    ['this-weekend',{title:'What’s on in Tasmania this weekend',eventMode:'weekend'}]
  ];
  return routes.map(([mode,config])=>({params:{mode},props:{config}}));
}
const { config } = Astro.props;
function hobartDate(date = new Date()) {
  const parts = new Intl.DateTimeFormat('en-AU',{timeZone:'Australia/Hobart',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(date);
  const get=(type)=>parts.find((part)=>part.type===type)?.value;
  return `${get('year')}-${get('month')}-${get('day')}`;
}
function money(event,value){if(value===undefined||value===null||Number.isNaN(Number(value)))return null;return new Intl.NumberFormat('en-AU',{style:'currency',currency:event.priceCurrency||'AUD',maximumFractionDigits:Number(value)%1===0?0:2}).format(Number(value));}
function ticketLabel(event){if(event.priceFrom===0)return'Free';const from=money(event,event.priceFrom),to=money(event,event.priceTo);if(from&&to&&from!==to)return`${from}–${to}`;if(from)return`From ${from}`;return event.ticketProvider||'Tickets available';}
const today = hobartDate();
const calendar = new Date(`${today}T00:00:00Z`);
const day = calendar.getUTCDay();
const sat = new Date(calendar); sat.setUTCDate(calendar.getUTCDate()+((6-day+7)%7));
const sun = new Date(sat); sun.setUTCDate(sat.getUTCDate()+1);
const satDate=sat.toISOString().slice(0,10), sunDate=sun.toISOString().slice(0,10);
const activePlaces=places.filter((p)=>p.status==='active'&&p.visibility!=='suppressed').sort((a,b)=>(b.qualityScore||0)-(a.qualityScore||0)||a.name.localeCompare(b.name));
const matchedPlaces=config.categories ? activePlaces.filter((p)=>config.categories.some((c)=>p.categories.includes(c))) : [];
const activeEvents=events.filter((e)=>e.status==='active'&&e.endDate>=today);
const matchedEvents=(config.eventMode==='today' ? activeEvents.filter((e)=>e.startDate<=today&&e.endDate>=today) : config.eventMode==='weekend' ? activeEvents.filter((e)=>e.startDate<=sunDate&&e.endDate>=satDate) : []).sort((a,b)=>a.startDate.localeCompare(b.startDate)||a.name.localeCompare(b.name));
---
<BaseLayout title={`${config.title} | TassieNow`} description={`${config.title}. Browse current, quality-ranked TassieNow listings and verify time-sensitive details with official sources.`}>
  <section class="listing-page"><p class="eyebrow">Live discovery</p><h1>{config.title}</h1>
  {config.eventMode ? <><p class="hero-copy">{matchedEvents.length} current event{matchedEvents.length===1?'':'s'} match this view.</p><div class="place-grid compact-grid">{matchedEvents.map((event)=><article class="place-card"><a class="card-image-link" href={`/event/${event.slug}/`}><img class="card-image" src={event.image.url} alt={event.image.alt} loading="lazy"/><span class="image-badge">Event</span></a><div class="card-body"><p class="location">{event.startDate}{event.endDate!==event.startDate?` – ${event.endDate}`:''} · {event.town}</p><h3>{event.name}</h3><p class="summary">{event.summary}</p>{event.ticketUrl&&<p class="ticket-summary"><strong>{ticketLabel(event)}</strong>{event.ticketProvider&&event.priceFrom!==undefined&&<> · {event.ticketProvider}</>}</p>}<div class="card-footer"><a class="card-link" href={`/event/${event.slug}/`}>Event details →</a>{event.ticketUrl&&<a class="card-link" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">Tickets ↗</a>}</div></div></article>)}</div>{matchedEvents.length===0&&<p class="empty-state visible">No verified events match this window yet. The automated event feed refreshes throughout the day.</p>}</> : <><p class="hero-copy">{matchedPlaces.length} useful places match this view.</p><div class="place-grid compact-grid">{matchedPlaces.map((place)=><article class="place-card"><a class="card-image-link" href={`/place/${place.slug}/`}><img class="card-image" src={place.image.url} alt={place.image.alt} loading="lazy"/><span class="image-badge">{place.categories[0]}</span></a><div class="card-body"><p class="location">{place.town} · {place.region}</p><h3>{place.name}</h3><p class="summary">{place.summary}</p><a class="card-link" href={`/place/${place.slug}/`}>View place →</a></div></article>)}</div></>}
  </section>
</BaseLayout>
