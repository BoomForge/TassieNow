---
import BaseLayout from '../layouts/BaseLayout.astro';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<BaseLayout title="TassieNow Admin" description="TassieNow owner administration." noindex={true}>
  {turnstileSiteKey && <script is:inline data-cfasync="false" data-member-turnstile src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>}
  <section class="content-shell admin-page" data-turnstile-key={turnstileSiteKey}>
    <div id="login-panel" class="admin-card login-card">
      <img src="/brand/tassienow-emblem.svg" alt="" class="admin-emblem" />
      <p class="eyebrow">Owner access</p><h1>TassieNow Admin</h1>
      <form id="login-form"><label>Username<input name="username" autocomplete="username" value="admin" required /></label><label>Password<input name="password" type="password" autocomplete="current-password" required /></label><div class="member-captcha"></div><button class="primary-button" type="submit">Log in</button><p id="login-status" class="admin-status" aria-live="polite"></p></form>
    </div>

    <div id="admin-panel" hidden>
      <div class="admin-heading"><div><p class="eyebrow">Owner dashboard</p><h1>Manage TassieNow</h1></div><button id="logout" class="secondary-button" type="button">Log out</button></div>
      <p><a href="/community-admin/">Review community reviews, photos & reports →</a></p>
      <p class="admin-status" id="global-status" aria-live="polite"></p>
      <nav class="admin-tabs" aria-label="Admin sections"><button class="tab active" data-tab="catalogue" type="button">Catalogue</button><button class="tab" data-tab="discovery" type="button">Discovery</button><button class="tab" data-tab="ads" type="button">Advertisements</button><button class="tab" data-tab="inquiries" type="button">Ad enquiries</button><button class="tab" data-tab="corrections" type="button">Free listing corrections</button></nav>

      <section class="admin-section" data-panel="catalogue">
        <div class="section-bar"><div><h2>Catalogue</h2><p>Manual edits are committed to GitHub and protected from the automatic importer.</p></div><button id="new-listing" class="primary-button" type="button">New listing</button></div>
        <div class="admin-grid catalogue-grid">
          <div class="admin-card"><label>Find a listing<input id="catalogue-search" type="search" placeholder="Search name, town or region…" /></label><label class="check-row"><input id="catalogue-missing-photos" type="checkbox" /> Only listings missing a real photograph</label><p class="microcopy">Select a listing to research exact photographs in Google Images and open-licensed collections.</p><div id="catalogue-list" class="catalogue-list"></div>
            <h3>Saved photo research leads</h3><p id="photo-queue-summary" class="microcopy">Loading saved leads…</p>
            <div id="photo-candidate-list" class="stack-list"></div></div>
          <form id="listing-form" class="admin-card editor-card">
            <input type="hidden" name="slug" />
            <h3 id="listing-form-title">Add a manual listing</h3>
            <div class="form-grid">
              <label>Name<input name="name" required /></label><label>Town<input name="town" required /></label><label>Region<select name="region" required><option>Hobart & South</option><option>Launceston & North</option><option>East Coast</option><option>North West</option><option>West Coast</option><option>Central Tasmania</option><option>King Island</option><option>Flinders Island</option></select></label><label>Categories<input name="categories" placeholder="Things to Do, Family" /></label><label>Latitude<input name="latitude" type="number" step="any" required /></label><label>Longitude<input name="longitude" type="number" step="any" required /></label><label class="span-2">Website<input name="website" type="url" placeholder="https://" /></label><label class="span-2">Summary<textarea name="summary" rows="4"></textarea></label>
              <div class="span-2 photo-research">
                <strong>1. Link to an original photograph or gallery (no licence required)</strong>
                <p class="microcopy">Show a clickable source link on the public listing. No photo is copied, embedded or counted as a recovered photo. Google can help find the original source.</p>
                <label>Original photo / gallery page<input name="photo_link_url" type="url" placeholder="https://original-site.example/gallery/photo" /></label>
                <label>Link label<input name="photo_link_title" placeholder="Photos of the market on the organiser's website" /></label>
                <label>Photographer / source credit (if known)<input name="photo_link_credit" /></label>
                <label class="check-row"><input name="photo_source_confirmed" type="checkbox" /> I checked that this is the correct place or event</label>
                <div class="form-actions"><button id="save-photo-source" type="button" class="secondary-button">Publish source link only</button><span id="photo-source-status" class="microcopy" aria-live="polite"></span></div>
                <div id="saved-photo-sources" class="stack-list"></div>
              </div>
              <label class="span-2">2. Photo file URL (for approved display only)<input name="image_url" type="text" placeholder="https://... or /uploads/admin/... after upload" /></label>
              <label>Photo handling<select name="image_display_mode"><option value="external-embed">Permitted external embed (loads from original server)</option><option value="hosted">Hosted copy (uploaded to TassieNow)</option></select></label>
              <label class="span-2 upload-field">Upload replacement image<input id="listing-image-file" type="file" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG or WebP · maximum 5 MB. Uploading fills the URL above automatically.</small></label>
              <div class="span-2 upload-row"><button id="upload-listing-image" class="secondary-button" type="button">Upload image</button><span id="listing-upload-status" class="admin-status"></span></div>
              <img id="listing-image-preview" class="image-preview span-2" alt="Selected listing image preview" hidden />
              <div id="photo-research-tools" class="span-2 photo-research" hidden>
                <strong>Find real photos — free Google research</strong>
                <div class="photo-research-links">
                  <a id="photo-google-images" target="_blank" rel="noopener noreferrer">Search Google Images ↗</a>
                  <a id="photo-google-cc" target="_blank" rel="noopener noreferrer">Google Images · Creative Commons filter ↗</a>
                  <a id="photo-google-commons" target="_blank" rel="noopener noreferrer">Find Commons photos through Google ↗</a>
                  <a id="photo-google-flickr" target="_blank" rel="noopener noreferrer">Find Flickr originals through Google ↗</a>
                  <a id="photo-source-website" target="_blank" rel="noopener noreferrer" hidden>Visit official business website ↗</a>
                </div>
                <small>Use all Google Images results to discover source links; a source link needs no image-reuse licence. For <strong>inline display or hosting</strong>, independently verify permission or an applicable open licence. Google Maps reviews, thumbnails and social posts are not automatically reusable.</small>
              </div>
              <div id="photo-candidate-review" class="span-2 photo-research" hidden>
                <strong id="photo-candidate-heading">Review source candidate</strong>
                <p id="photo-candidate-description" class="microcopy"></p>
                <a id="photo-candidate-original" target="_blank" rel="noopener noreferrer">Inspect original photo and licence ↗</a>
                <label>Verification notes (exclude private contact information)<textarea id="photo-candidate-note" rows="3" placeholder="How did you verify the actual place, photographer, licence/version and reuse conditions?"></textarea></label>
                <label class="check-row"><input id="photo-candidate-identity" type="checkbox" /> Exact photographed place and town verified</label>
                <label class="check-row"><input id="photo-candidate-rights" type="checkbox" /> Rights verified at original source</label>
                <div class="form-actions"><button id="photo-link-candidate" type="button" class="secondary-button">Prepare source link (no licence)</button><button id="photo-verify-candidate" type="button" class="secondary-button">Mark source verified</button><button id="photo-reject-candidate" type="button" class="secondary-button">Reject lead</button><button id="photo-use-candidate" type="button" class="secondary-button">Use verified details</button></div>
                <p id="photo-candidate-status" class="microcopy" aria-live="polite"></p>
              </div>
              <label>Photo description (alt text)<input name="image_alt" /></label><label>Photographer / rights-holder credit<input name="image_attribution" /></label>
              <label>Reuse licence<input name="image_license" placeholder="CC BY 4.0, CC BY-SA 2.0, CC0 1.0, Public domain, Rights-holder permission" /></label>
              <label>Licence details URL<input name="image_license_url" type="url" placeholder="https://creativecommons.org/licenses/by/4.0/" /></label>
              <label class="span-2">Original photographer / image source page<input name="image_source_url" type="url" placeholder="https://commons.wikimedia.org/wiki/File:..." /></label>
              <label class="span-2">Rights evidence (public, no private email/contact details)<textarea name="image_permission_notes" rows="3" placeholder="For direct permission: rights-holder, grant date YYYY-MM-DD and permitted website usage. For public domain: specific documentary basis."></textarea></label>
              <label class="span-2 check-row"><input name="image_rights_confirmed" type="checkbox" /> I checked the actual photograph, original source, subject identity and website embedding or hosting rights. Required only for displayed images, not source links.</label><label>Visibility<select name="visibility"><option value="public">Public</option><option value="suppressed">Hidden</option></select></label><label class="check-row"><input name="featured" type="checkbox" /> Featured</label>
            </div>
            <p class="microcopy" id="listing-source"></p><div class="form-actions"><button class="primary-button" type="submit">Save listing</button><button id="cancel-listing" class="secondary-button" type="button">Clear</button><span id="listing-status" class="admin-status"></span></div>
          </form>
        </div>
      </section>

      <section class="admin-section" data-panel="discovery" hidden>
        <div class="section-bar"><div><h2>Discovery</h2><p>Daily scans find markets from council and tourism sources. Open the source to verify missing details before adding a listing.</p></div></div>
        <p id="discovery-summary" class="admin-status"></p>
        <div id="discovery-sources" class="admin-card"></div>
        <h3>Needs review</h3><div id="discovery-list" class="stack-list"></div>
      </section>

      <section class="admin-section" data-panel="ads" hidden>
        <div class="section-bar"><div><h2>Advertisements</h2><p>Schedule campaigns by exact start/end time. Only scheduled ads inside their live window are shown.</p></div></div>
        <div class="admin-grid ads-grid">
          <form id="ad-form" class="admin-card editor-card"><input type="hidden" name="id" /><h3 id="ad-form-title">Add advertisement</h3><div class="form-grid">
            <label>Sponsor name<input name="sponsor_name" required /></label><label>Client/contact name<input name="client_name" /></label>
            <label class="span-2">Ad image URL<input name="image_url" type="url" placeholder="https://" required /></label>
            <label class="span-2 upload-field">Upload advertisement image<input id="ad-image-file" type="file" accept="image/jpeg,image/png,image/webp" /><small>JPG, PNG or WebP · maximum 5 MB. Uploading fills the URL above automatically.</small></label>
            <div class="span-2 upload-row"><button id="upload-ad-image" class="secondary-button" type="button">Upload image</button><span id="ad-upload-status" class="admin-status"></span></div>
            <img id="ad-image-preview" class="image-preview span-2" alt="Advertisement image preview" hidden />
            <label class="span-2">Image alt text<input name="alt_text" required /></label><label class="span-2">Destination URL<input name="destination_url" type="url" placeholder="https://" required /></label><label>Placement<select name="placement"><option value="homepage-top">Homepage top</option><option value="homepage-inline">Homepage inline</option><option value="content-inline">Content inline</option><option value="site-footer">Site footer</option></select></label><label>Status<select name="status"><option value="draft">Draft</option><option value="scheduled">Scheduled</option><option value="paused">Paused</option></select></label><label>Starts<input name="start_at" type="datetime-local" required /></label><label>Ends<input name="end_at" type="datetime-local" /></label><label>Rotation weight<input name="weight" type="number" min="1" max="100" value="1" /></label><label class="span-2">Notes<textarea name="notes" rows="3"></textarea></label>
          </div><div class="form-actions"><button class="primary-button" type="submit">Save advertisement</button><button id="clear-ad" class="secondary-button" type="button">Clear</button><span id="ad-status" class="admin-status"></span></div></form>
          <div class="admin-card"><h3>Campaigns</h3><div id="ad-list" class="stack-list"></div></div>
        </div>
      </section>

      <section class="admin-section" data-panel="inquiries" hidden><div class="section-bar"><div><h2>Advertising enquiries</h2><p>Messages sent from the public advertising page.</p></div></div><div id="inquiry-list" class="stack-list"></div></section>
      <section class="admin-section" data-panel="corrections" hidden>
        <div class="section-bar"><div><h2>Free listing corrections</h2><p>Review community suggestions. Accepting a suggestion does not publish it; use the Catalogue editor to make and save verified changes.</p></div></div>
        <label>Review status <select id="correction-filter"><option value="pending">Pending review</option><option value="approved">Accepted for editing</option><option value="rejected">Rejected</option></select></label>
        <p id="correction-admin-status" role="status" aria-live="polite"></p>
        <div id="correction-review-list" class="stack-list"></div>
      </section>
    </div>
  </section>

  <script is:inline data-cfasync="false" type="module" src="/scripts/member-admin-captcha.js"></script>
  <script>
    const loginPanel=document.querySelector('#login-panel'),adminPanel=document.querySelector('#admin-panel'),globalStatus=document.querySelector('#global-status');
    let catalogue=[],ads=[],photoQueue={},activeCandidate=null;
    const esc=(v='')=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    async function api(url,options={}){const r=await fetch(url,{...options,headers:{accept:'application/json',...(options.body?{'content-type':'application/json'}:{}),...(options.headers||{})},cache:'no-store'});const data=await r.json().catch(()=>({}));if(r.status===401){showLogin();throw new Error('Your admin session has expired.');}if(!r.ok)throw new Error(data.error||`Request failed (${r.status})`);return data;}
    async function uploadImage(file,label){const form=new FormData();form.append('file',file);form.append('label',label||'image');const r=await fetch('/api/admin/upload',{method:'POST',body:form,headers:{accept:'application/json'},cache:'no-store'});const data=await r.json().catch(()=>({}));if(r.status===401){showLogin();throw new Error('Your admin session has expired.');}if(!r.ok)throw new Error(data.error||`Upload failed (${r.status})`);return data;}
    function showLogin(){loginPanel.hidden=false;adminPanel.hidden=true}function showAdmin(){loginPanel.hidden=true;adminPanel.hidden=false;loadAll()}
    document.querySelector('#login-form').addEventListener('submit',async e=>{e.preventDefault();const s=document.querySelector('#login-status');s.textContent='Logging in…';try{await api('/api/admin/login',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.currentTarget).entries()))});s.textContent='';showAdmin()}catch(err){window.turnstile?.reset();s.textContent=err.message}});
    document.querySelector('#logout').addEventListener('click',async()=>{try{await api('/api/admin/logout',{method:'POST',body:'{}'})}finally{showLogin()}});
    document.querySelectorAll('.tab').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==btn.dataset.tab)}));
    async function loadAll(){globalStatus.textContent='Loading…';const results=await Promise.allSettled([loadCatalogue(),loadAds(),loadInquiries(),loadDiscovery(),loadCorrections(),loadPhotoResearch()]);const failures=results.filter(x=>x.status==='rejected');globalStatus.textContent=failures.length?failures.map(x=>x.reason.message).join(' · '):''}

    async function loadDiscovery(){const {candidates=[],report={}}=await api('/api/admin/discovery');const totals=report.totals||{};document.querySelector('#discovery-summary').textContent=report.checkedAt?`Last scan: ${new Date(report.checkedAt).toLocaleString('en-AU',{timeZone:'Australia/Hobart'})} Hobart · ${totals.added||0} added · ${totals.review||0} need review`:'Discovery has not run yet.';document.querySelector('#discovery-sources').innerHTML=(report.sources||[]).map(s=>`<p><strong>${esc(s.name)}</strong> · ${s.pagesFetched} pages · ${s.errors.length?'Needs attention: '+esc(s.errors.map(e=>e.message).join(', ')):'OK'}</p>`).join('');document.querySelector('#discovery-list').innerHTML=candidates.filter(c=>c.status==='review').map(c=>`<div class="stack-item"><div><strong>${esc(c.name)}</strong><small>${esc(c.town||'Town not verified')} · ${esc(c.sourceName)} · Last seen ${esc(c.lastSeen)}</small><p>${esc(c.reasons.join(' · '))}</p><a href="${esc(c.url)}" target="_blank" rel="noopener noreferrer">Check source</a></div></div>`).join('')||'<p>No discoveries awaiting review.</p>';}

    async function loadPhotoResearch(){
      try {
        const result=await api('/api/admin/photo-research');
        photoQueue=result.queue||{};
        renderPhotoResearch();
      } catch(error) {
        document.querySelector('#photo-queue-summary').textContent='Research queue unavailable: '+error.message;
      }
    }
    function renderPhotoResearch(){
      const leads=Object.entries(photoQueue).flatMap(([slug,entry])=>(entry.candidates||[]).map(candidate=>({slug,entry,candidate})));
      const pending=leads.filter(item=>item.candidate.review?.status!=='rejected'&&item.candidate.review?.status!=='source-verified').length;
      document.querySelector('#photo-queue-summary').textContent=`${leads.length} candidate(s) for ${Object.keys(photoQueue).length} listings · ${pending} awaiting original-source checks. None publish automatically.`;
      leads.sort((a,b)=>Number(Boolean(catalogue.find(p=>p.slug===b.slug)?.categories?.includes('Markets')))-Number(Boolean(catalogue.find(p=>p.slug===a.slug)?.categories?.includes('Markets')))||a.entry.name.localeCompare(b.entry.name));
      document.querySelector('#photo-candidate-list').innerHTML=leads.map(({slug,entry,candidate})=>
        `<div class="stack-item"><div><strong>${esc(entry.name)} · ${esc(entry.town)}</strong><small>${esc(candidate.title)} · ${esc(candidate.licence)} · ${esc(candidate.review?.status||'needs-verification')}</small><button class="secondary-button" data-photo-slug="${esc(slug)}" data-photo-id="${esc(candidate.id)}" type="button">Review original</button></div></div>`
      ).join('')||'<p class="microcopy">No indexed candidates yet. Use the free Google links for each listing.</p>';
      document.querySelectorAll('[data-photo-id]').forEach(button=>button.addEventListener('click',()=>selectPhotoCandidate(button.dataset.photoSlug,button.dataset.photoId)));
    }
    function currentCandidate(){return activeCandidate&&photoQueue[activeCandidate.slug]?.candidates?.find(c=>c.id===activeCandidate.id)}
    function selectPhotoCandidate(slug,id){
      const entry=photoQueue[slug],candidate=entry?.candidates?.find(c=>c.id===id);
      if(!candidate)return;
      editListing(slug);
      activeCandidate={slug,id};
      document.querySelector('#photo-candidate-review').hidden=false;
      document.querySelector('#photo-candidate-heading').textContent='Verify: '+entry.name;
      document.querySelector('#photo-candidate-description').textContent=`${candidate.title} · photographer ${candidate.credit} · indexed licence ${candidate.licence}. Index claims require independent checks.`;
      document.querySelector('#photo-candidate-original').href=candidate.sourcePage;
      document.querySelector('#photo-candidate-note').value=candidate.review?.note||'';
      document.querySelector('#photo-candidate-identity').checked=Boolean(candidate.review?.identityConfirmed);
      document.querySelector('#photo-candidate-rights').checked=Boolean(candidate.review?.rightsConfirmed);
      document.querySelector('#photo-candidate-status').textContent=candidate.review?.status||'Not verified. Inspect the original source.';
      document.querySelector('#photo-use-candidate').disabled=candidate.review?.status!=='source-verified';
    }
    async function updatePhotoCandidate(status){
      const candidate=currentCandidate(),selected=activeCandidate;
      if(!candidate||!selected)return;
      const note=document.querySelector('#photo-candidate-note').value;
      const identityVerified=document.querySelector('#photo-candidate-identity').checked;
      const rightsVerified=document.querySelector('#photo-candidate-rights').checked;
      const message=document.querySelector('#photo-candidate-status');
      message.textContent='Saving review…';
      try {
        await api('/api/admin/photo-research',{method:'PATCH',body:JSON.stringify({...selected,status,note,identityVerified,rightsVerified})});
        await loadPhotoResearch();
        selectPhotoCandidate(selected.slug,selected.id);
        message.textContent='Saved. No photo was published.';
      } catch(error){message.textContent=error.message;}
    }
    document.querySelector('#photo-link-candidate').addEventListener('click',()=>{
      const candidate=currentCandidate();if(!candidate)return;
      const f=document.querySelector('#listing-form');
      f.photo_link_url.value=candidate.sourcePage;
      f.photo_link_title.value=candidate.title||'Original photo source';
      f.photo_link_credit.value=candidate.credit||'';
      f.photo_source_confirmed.checked=false;
      document.querySelector('#photo-source-status').textContent='Original source prepared. Check identity, tick confirmation and publish the link separately.';
      f.photo_link_url.scrollIntoView({behavior:'smooth',block:'center'});
    });
    document.querySelector('#photo-verify-candidate').addEventListener('click',()=>updatePhotoCandidate('source-verified'));
    document.querySelector('#photo-reject-candidate').addEventListener('click',()=>updatePhotoCandidate('rejected'));
    document.querySelector('#photo-use-candidate').addEventListener('click',()=>{
      const candidate=currentCandidate();
      if(!candidate||candidate.review?.status!=='source-verified')return;
      const form=document.querySelector('#listing-form');
      form.image_url.value=candidate.url;
      form.image_display_mode.value='external-embed';
      form.image_alt.value=candidate.title;
      form.image_attribution.value=candidate.credit;
      form.image_license.value='CC '+candidate.licence.replace(/^CC /i,'');
      form.image_license_url.value=candidate.licenceUrl;
      form.image_source_url.value=candidate.sourcePage;
      form.image_permission_notes.value=candidate.review.note||'';
      form.image_rights_confirmed.checked=false;
      setPreview('#listing-image-preview',candidate.url);
      document.querySelector('#photo-candidate-status').textContent='Fields copied. Confirm the image, adjust alt text, check rights confirmation, then save the listing separately.';
    });

    async function loadCatalogue(){const data=await api('/api/admin/catalogue');catalogue=data.places||[];renderCatalogue()}
    function renderCatalogue(){const q=document.querySelector('#catalogue-search').value.trim().toLowerCase();const onlyMissing=document.querySelector('#catalogue-missing-photos').checked;const rows=catalogue.filter(p=>(!onlyMissing||(p.visibility!=='suppressed'&&p.image?.isFallback===true))&&(!q||`${p.name} ${p.town} ${p.region}`.toLowerCase().includes(q))).sort((a,b)=>onlyMissing?(Number(b.categories?.includes('Markets'))-Number(a.categories?.includes('Markets'))||Number(b.categories?.includes('Food & Drink'))-Number(a.categories?.includes('Food & Drink'))||a.name.localeCompare(b.name)):0).slice(0,120);document.querySelector('#catalogue-list').innerHTML=rows.map(p=>`<button class="catalogue-row" type="button" data-slug="${esc(p.slug)}"><span><strong>${esc(p.name)}</strong><small>${esc(p.town)} · ${esc(p.region)}</small></span><em>${p.visibility==='suppressed'?'Hidden':p.featured?'Featured':esc(p.sourceType||'')}</em></button>`).join('')||'<p>No matching listings.</p>';document.querySelectorAll('.catalogue-row').forEach(b=>b.addEventListener('click',()=>editListing(b.dataset.slug)))}
    document.querySelector('#catalogue-search').addEventListener('input',renderCatalogue);
    document.querySelector('#catalogue-missing-photos').addEventListener('change',renderCatalogue);
    function setPreview(id,url){const img=document.querySelector(id);if(url){img.src=url;img.hidden=false}else{img.removeAttribute('src');img.hidden=true}}
    function clearListing(){const f=document.querySelector('#listing-form');f.reset();document.querySelector('#saved-photo-sources').replaceChildren();document.querySelector('#photo-source-status').textContent='';activeCandidate=null;document.querySelector('#photo-candidate-review').hidden=true;document.querySelector('#photo-research-tools').hidden=true;f.slug.value='';setPreview('#listing-image-preview','');document.querySelector('#listing-form-title').textContent='Add a manual listing';document.querySelector('#listing-source').textContent='';document.querySelector('#listing-status').textContent='';document.querySelector('#listing-upload-status').textContent=''}
    function googleSearchUrl(terms,{images=false}={}){
      const url=new URL('https://www.google.com/search');
      url.searchParams.set('q',terms);
      if(images)url.searchParams.set('udm','2');
      return url.href;
    }
    function setGooglePhotoResearch(place){
      // Search links open Google's normal browser UI; no scraping, billing or automated image copying.
      const terms=[place.name,place.town,'Tasmania'].filter(Boolean).join(' ');
      document.querySelector('#photo-google-images').href=googleSearchUrl(terms,{images:true});
      const cc=new URL(googleSearchUrl(terms,{images:true}));
      cc.searchParams.set('tbs','il:cl'); // Google may change this; reviewer can also use Tools > Usage rights.
      document.querySelector('#photo-google-cc').href=cc.href;
      document.querySelector('#photo-google-commons').href=googleSearchUrl(terms+' site:commons.wikimedia.org/wiki/File:');
      document.querySelector('#photo-google-flickr').href=googleSearchUrl(terms+' site:flickr.com/photos/');
      const site=document.querySelector('#photo-source-website');
      site.hidden=!place.website||!/^https:\/\//i.test(place.website);
      if(!site.hidden)site.href=place.website;
      document.querySelector('#photo-research-tools').hidden=false;
    }
    function editListing(slug){const p=catalogue.find(x=>x.slug===slug);if(!p)return;const f=document.querySelector('#listing-form');clearListing();f.slug.value=p.slug;f.name.value=p.name||'';f.town.value=p.town||'';f.region.value=p.region||'Hobart & South';f.categories.value=(p.categories||[]).join(', ');f.latitude.value=p.latitude??'';f.longitude.value=p.longitude??'';f.website.value=p.website||'';f.summary.value=p.summary||'';f.visibility.value=p.visibility||'public';f.featured.checked=Boolean(p.featured);f.image_url.value=p.image?.isFallback?'':p.image?.url||'';f.image_display_mode.value=p.image?.useMode || (/^\/uploads\/admin\//.test(p.image?.url||'')?'hosted':'external-embed');renderSavedPhotoSources(p);f.image_alt.value=p.image?.alt||'';f.image_attribution.value=p.image?.attribution||'';f.image_license.value=p.image?.license||'';f.image_license_url.value=p.image?.licenseUrl||'';f.image_source_url.value=p.image?.sourceUrl||'';f.image_permission_notes.value=p.image?.rightsEvidence?.note||'';setPreview('#listing-image-preview',f.image_url.value);setGooglePhotoResearch(p);document.querySelector('#listing-form-title').textContent=`Edit ${p.name}`;document.querySelector('#listing-source').textContent=`Source: ${p.sourceType||'unknown'} · Quality score: ${p.qualityScore||0}`;f.scrollIntoView({behavior:'smooth',block:'start'})}
    document.querySelector('#new-listing').addEventListener('click',()=>{clearListing();document.querySelector('#listing-form').scrollIntoView({behavior:'smooth'})});document.querySelector('#cancel-listing').addEventListener('click',clearListing);
        function renderSavedPhotoSources(place){
      const list=document.querySelector('#saved-photo-sources');
      list.innerHTML=(place.photoLinks||[]).map(link=>`<div class="stack-item"><div><a href="${esc(link.sourceUrl)}" target="_blank" rel="noopener noreferrer">${esc(link.title)} ↗</a><small>${esc(link.credit||'Original third-party source')} · Link only — not a hosted or embedded photo</small></div><button class="secondary-button" type="button" data-remove-photo-url="${esc(link.sourceUrl)}">Remove</button></div>`).join('')||'<p class="microcopy">No source links saved for this listing yet.</p>';
      list.querySelectorAll('[data-remove-photo-url]').forEach(btn=>btn.addEventListener('click',async()=>{
        const s=document.querySelector('#photo-source-status');s.textContent='Removing source link…';
        try{
          await api('/api/admin/catalogue',{method:'POST',body:JSON.stringify({action:'remove-photo-source',slug:place.slug,photo_link_url:btn.dataset.removePhotoUrl})});
          await loadCatalogue();editListing(place.slug);document.querySelector('#photo-source-status').textContent='Source link removed.';
        }catch(error){s.textContent=error.message}
      }));
    }
    document.querySelector('#save-photo-source').addEventListener('click',async()=>{
      const f=document.querySelector('#listing-form'),s=document.querySelector('#photo-source-status');
      if(!f.slug.value){s.textContent='Save the new listing first.';return}
      s.textContent='Publishing source link…';
      try {
        await api('/api/admin/catalogue',{method:'POST',body:JSON.stringify({action:'link-photo-source',slug:f.slug.value,photo_link_url:f.photo_link_url.value,photo_link_title:f.photo_link_title.value,photo_link_credit:f.photo_link_credit.value,photo_source_confirmed:f.photo_source_confirmed.checked})});
        const slug=f.slug.value;await loadCatalogue();editListing(slug);
        document.querySelector('#photo-source-status').textContent='Source link saved separately. No image was copied or counted as a real hero.';
      }catch(error){s.textContent=error.message}
    });
    document.querySelector('#upload-listing-image').addEventListener('click',async()=>{const f=document.querySelector('#listing-form'),input=document.querySelector('#listing-image-file'),s=document.querySelector('#listing-upload-status'),file=input.files?.[0];if(!file){s.textContent='Choose an image first.';return}s.textContent='Uploading…';try{const data=await uploadImage(file,f.name.value||'listing');f.image_url.value=data.url;f.image_display_mode.value='hosted';setPreview('#listing-image-preview',data.url);s.textContent='Uploaded. Save the listing when ready.'}catch(err){s.textContent=err.message}});
    document.querySelector('#listing-form').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,s=document.querySelector('#listing-status'),raw=Object.fromEntries(new FormData(f).entries());const payload={...raw,action:raw.slug?'update':'add',featured:f.featured.checked,image_rights_confirmed:f.image_rights_confirmed.checked,categories:raw.categories.split(',').map(x=>x.trim()).filter(Boolean)};s.textContent='Saving to GitHub…';try{await api('/api/admin/catalogue',{method:'POST',body:JSON.stringify(payload)});s.textContent='Saved. Cloudflare will rebuild automatically.';await loadCatalogue()}catch(err){s.textContent=err.message}});

    function localValue(iso){if(!iso)return'';const d=new Date(iso);return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,16)}
    function derivedAdStatus(a){if(a.status!=='scheduled')return a.status;const n=Date.now(),s=new Date(a.start_at).getTime(),e=a.end_at?new Date(a.end_at).getTime():Infinity;return n<s?'upcoming':n>=e?'expired':'live'}
    async function loadAds(){const data=await api('/api/admin/ads');ads=data.ads||[];document.querySelector('#ad-list').innerHTML=ads.map(a=>`<article class="stack-item"><div><strong>${esc(a.sponsor_name)}</strong><small>${esc(a.placement)} · ${esc(derivedAdStatus(a))} · ${Number(a.impressions||0)} impressions · ${Number(a.clicks||0)} clicks</small><small>${esc(new Date(a.start_at).toLocaleString())}${a.end_at?` → ${esc(new Date(a.end_at).toLocaleString())}`:''}</small></div><div class="row-actions"><button type="button" data-edit-ad="${a.id}">Edit</button><button type="button" data-delete-ad="${a.id}">Delete</button></div></article>`).join('')||'<p>No advertisements yet.</p>';document.querySelectorAll('[data-edit-ad]').forEach(b=>b.addEventListener('click',()=>editAd(Number(b.dataset.editAd))));document.querySelectorAll('[data-delete-ad]').forEach(b=>b.addEventListener('click',()=>deleteAd(Number(b.dataset.deleteAd))))}
    function clearAd(){const f=document.querySelector('#ad-form');f.reset();f.id.value='';f.weight.value='1';f.status.value='draft';setPreview('#ad-image-preview','');document.querySelector('#ad-form-title').textContent='Add advertisement';document.querySelector('#ad-status').textContent='';document.querySelector('#ad-upload-status').textContent=''}
    function editAd(id){const a=ads.find(x=>Number(x.id)===id);if(!a)return;const f=document.querySelector('#ad-form');clearAd();for(const key of ['sponsor_name','client_name','image_url','alt_text','destination_url','placement','status','weight','notes'])if(f[key])f[key].value=a[key]??'';f.id.value=a.id;f.start_at.value=localValue(a.start_at);f.end_at.value=localValue(a.end_at);setPreview('#ad-image-preview',a.image_url||'');document.querySelector('#ad-form-title').textContent=`Edit ${a.sponsor_name}`;f.scrollIntoView({behavior:'smooth'})}
    async function deleteAd(id){if(!confirm('Delete this advertisement?'))return;await api(`/api/admin/ads/${id}`,{method:'DELETE',body:'{}'});await loadAds()}
    document.querySelector('#clear-ad').addEventListener('click',clearAd);
    document.querySelector('#upload-ad-image').addEventListener('click',async()=>{const f=document.querySelector('#ad-form'),input=document.querySelector('#ad-image-file'),s=document.querySelector('#ad-upload-status'),file=input.files?.[0];if(!file){s.textContent='Choose an image first.';return}s.textContent='Uploading…';try{const data=await uploadImage(file,f.sponsor_name.value||'advertisement');f.image_url.value=data.url;setPreview('#ad-image-preview',data.url);s.textContent='Uploaded. Save the advertisement when ready.'}catch(err){s.textContent=err.message}});
    document.querySelector('#ad-form').addEventListener('submit',async e=>{e.preventDefault();const f=e.currentTarget,s=document.querySelector('#ad-status'),raw=Object.fromEntries(new FormData(f).entries());const id=raw.id;raw.start_at=new Date(raw.start_at).toISOString();raw.end_at=raw.end_at?new Date(raw.end_at).toISOString():null;s.textContent='Saving…';try{await api(id?`/api/admin/ads/${id}`:'/api/admin/ads',{method:id?'PUT':'POST',body:JSON.stringify(raw)});s.textContent='Saved.';clearAd();await loadAds()}catch(err){s.textContent=err.message}});

    async function loadInquiries(){const data=await api('/api/admin/inquiries');const rows=data.inquiries||[];document.querySelector('#inquiry-list').innerHTML=rows.map(i=>`<article class="admin-card inquiry"><div class="inquiry-head"><div><strong>${esc(i.business)}</strong><small>${esc(i.name)} · <a href="mailto:${esc(i.email)}">${esc(i.email)}</a>${i.phone?` · ${esc(i.phone)}`:''}</small></div><span class="status-pill">${esc(i.status)}</span></div><p>${esc(i.message)}</p><small>${esc(i.placement||'Placement not specified')} · ${esc(i.desired_start||'No start date')}${i.desired_end?` → ${esc(i.desired_end)}`:''} · received ${esc(new Date(i.created_at+'Z').toLocaleString())}</small><div class="row-actions"><button type="button" data-inquiry="${i.id}" data-status="contacted">Mark contacted</button><button type="button" data-inquiry="${i.id}" data-status="closed">Close</button></div></article>`).join('')||'<div class="admin-card"><p>No advertising enquiries yet.</p></div>';document.querySelectorAll('[data-inquiry]').forEach(b=>b.addEventListener('click',async()=>{await api('/api/admin/inquiries',{method:'PATCH',body:JSON.stringify({id:Number(b.dataset.inquiry),status:b.dataset.status})});await loadInquiries()}))}

    async function loadCorrections(){
      const status=document.querySelector('#correction-admin-status');
      const filter=document.querySelector('#correction-filter').value;
      const list=document.querySelector('#correction-review-list');
      const data=await api('/api/admin/listing-corrections?status='+encodeURIComponent(filter));
      const rows=data.corrections||[];
      status.textContent=rows.length+' '+filter+' correction(s). Approval is review only; publication requires a manual catalogue edit.';
      list.innerHTML=rows.map(item=>`<article class="admin-card inquiry">
        <div class="inquiry-head"><div><strong>${esc(item.place_name)}</strong> <small>· ${esc(item.place_slug)}</small>
        <small>${esc(item.field)} · ${esc(item.relationship)} · ${esc(item.submitted_at)}</small></div><span class="status-pill">${esc(item.status)}</span></div>
        <p><strong>Suggested change</strong></p><p>${esc(item.suggested_value)}</p>
        ${item.reason?`<p>Reason: ${esc(item.reason)}</p>`:''}
        ${item.source_url?`<p><a href="${esc(item.source_url)}" target="_blank" rel="noopener noreferrer">Supporting source</a></p>`:''}
        <p><small>Submitted by ${esc(item.requester_name)} (${esc(item.requester_email)})</small></p>
        <div class="row-actions"><a href="/place/${encodeURIComponent(item.place_slug)}/" target="_blank" rel="noopener noreferrer">View place</a>
        ${filter==='pending'?`<button type="button" data-correction-id="${item.id}" data-review="approved">Accept for editing</button><button type="button" data-correction-id="${item.id}" data-review="rejected">Reject</button>`:''}
        </div></article>`).join('')||'<p class="admin-card">No corrections in this queue.</p>';
      list.querySelectorAll('[data-correction-id]').forEach(button=>button.addEventListener('click',async()=>{
        button.disabled=true;status.textContent='Saving review…';
        try{
          await api('/api/admin/listing-corrections',{method:'PATCH',body:JSON.stringify({id:Number(button.dataset.correctionId),status:button.dataset.review})});
          await loadCorrections();
        }catch(error){status.textContent=error.message;button.disabled=false;}
      }));
    }
    document.querySelector('#correction-filter').addEventListener('change',()=>loadCorrections().catch(error=>{document.querySelector('#correction-admin-status').textContent=error.message}));
    api('/api/admin/session').then(x=>x.authenticated?showAdmin():showLogin()).catch(showLogin);
  </script>
  <style>
    .admin-page{padding:2.5rem 1.25rem 5rem}.login-card{max-width:420px;margin:3rem auto}.admin-emblem{width:64px;height:64px}.admin-card{background:#fff;border:1px solid #dce5e7;border-radius:18px;padding:1.2rem;box-shadow:0 10px 30px rgba(6,45,50,.05)}.login-card form,.editor-card{display:grid;gap:1rem}.admin-page label{display:grid;gap:.35rem;font-weight:700;color:#173f43}.admin-page input,.admin-page select,.admin-page textarea{width:100%;box-sizing:border-box;border:1px solid #bccdce;border-radius:10px;padding:.75rem;font:inherit;background:#fff}.admin-heading,.section-bar,.inquiry-head{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.admin-tabs{display:flex;gap:.5rem;flex-wrap:wrap;margin:1.5rem 0}.tab,.row-actions button{border:1px solid #b7cbcd;background:#fff;border-radius:999px;padding:.55rem .85rem;cursor:pointer}.tab.active{background:#027B87;color:#fff;border-color:#027B87}.admin-grid{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(420px,1.4fr);gap:1rem}.ads-grid{grid-template-columns:minmax(420px,1fr) minmax(320px,1fr)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}.span-2{grid-column:1/-1}.check-row{display:flex!important;align-items:center;gap:.5rem!important}.check-row input{width:auto}.form-actions,.row-actions,.upload-row{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.admin-status{color:#536568}.catalogue-list,.stack-list{display:grid;gap:.55rem;max-height:720px;overflow:auto}.catalogue-row,.stack-item{display:flex;width:100%;box-sizing:border-box;justify-content:space-between;gap:1rem;text-align:left;border:1px solid #e1e9ea;border-radius:12px;padding:.7rem;background:#fff}.catalogue-row{cursor:pointer}.catalogue-row span,.stack-item>div{display:grid;gap:.2rem}.catalogue-row small,.stack-item small,.microcopy,.upload-field small{color:#66787a;font-size:.78rem}.catalogue-row em{font-size:.72rem;color:#027B87;font-style:normal}.stack-item{align-items:center}.inquiry{margin-bottom:.8rem}.inquiry p{white-space:pre-wrap}.status-pill{background:#eef6f6;border-radius:999px;padding:.3rem .6rem;font-size:.75rem}.section-bar{margin:1rem 0}.section-bar h2{margin-bottom:.2rem}.image-preview{display:block;width:min(100%,520px);max-height:280px;object-fit:cover;border:1px solid #dce5e7;border-radius:14px;background:#f5f8f8}.image-preview[hidden]{display:none}.upload-field input[type=file]{padding:.55rem}.upload-row .secondary-button{white-space:nowrap}@media(max-width:850px){.admin-grid,.ads-grid,.form-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.admin-heading,.section-bar{align-items:stretch;flex-direction:column}}
    .photo-research{border:1px solid var(--line,#b5c7c3);border-radius:12px;padding:.85rem;display:grid;gap:.55rem}
    .photo-research[hidden]{display:none}\n    .stack-item button{width:max-content;cursor:pointer}\n    #photo-candidate-list{max-height:350px}
    .photo-research-links{display:flex;gap:.6rem 1rem;flex-wrap:wrap}
    .photo-research-links a{font-weight:650;text-decoration:underline}
    .photo-research small{line-height:1.6;color:var(--muted,#48575a)}
  </style>
</BaseLayout>